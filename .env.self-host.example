# Copy to .env, set permissions to 0600, and replace every placeholder.
# Validate before starting anything: npm run self-host:check

# One published Core artifact, pinned by digest. The digest value must match
# the suffix of TYPEROLL_IMAGE exactly.
TYPEROLL_IMAGE=ghcr.io/typeroll/typeroll@sha256:replace-me-with-64-hex-characters
TYPEROLL_IMAGE_DIGEST=sha256:replace-me-with-64-hex-characters

# Public DNS records pointing at this Docker host. Caddy obtains TLS
# certificates automatically after ports 80 and 443 are reachable.
TYPEROLL_PORTAL_HOST=cms.your-domain.example
TYPEROLL_FORMS_HOST=forms.your-domain.example
TYPEROLL_ACME_EMAIL=ops@your-domain.example

# Firebase Admin service-account JSON on one line. Keep the escaped \n inside
# private_key; single quotes keep Compose from interpreting JSON characters.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"replace-me","client_email":"replace-me","private_key":"replace-me"}'
PUBLIC_FIREBASE_API_KEY=replace-me
PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=replace-me
PUBLIC_FIREBASE_APP_ID=replace-me
# Optional: true shows "Continue with GitHub" on the sign-in page. Enable the
# GitHub provider in Firebase Authentication with a GitHub OAuth App first.
PUBLIC_FIREBASE_GITHUB_SIGNIN=false

# Cloudflare R2 media storage. The public base URL must be HTTPS.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=typeroll-media
R2_PUBLIC_BASE_URL=https://media.your-domain.example

# Cloudflare Pages site hosting. The token needs Pages Edit and DNS Edit for
# the zone containing SITES_BASE_DOMAIN.
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
SITES_BASE_DOMAIN=sites.your-domain.example

# Generate each value independently:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FORMS_HMAC_SECRET=replace-me
PREVIEW_HMAC_SECRET=replace-me
INTEGRATIONS_SECRET_KEY=replace-me
MCP_OAUTH_SIGNING_KEY=replace-me

# Encrypts and authenticates self-host backups. Store a second copy outside
# this host; losing both the host and this key makes encrypted backups unusable.
TYPEROLL_BACKUP_KEY=replace-me

# Generate a P-256 private JWK and store the complete JSON on one line.
EXTENSION_SIGNING_PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"replace-me","y":"replace-me","d":"replace-me"}'

# There is no server-wide AI key. Each organization adds its own Anthropic key
# in the portal (Organization settings → AI assistant); it is stored encrypted
# with INTEGRATIONS_SECRET_KEY. MCP and the API work without it.

# Optional: compose.yaml sets AUTH_TRUST_PROXY_HOPS=1 for portal and Forms
# because Caddy appends exactly one X-Forwarded-For hop. Use 2 only when a CDN
# or proxy in front of Caddy is listed in Caddy's trusted_proxies.
# AUTH_TRUST_PROXY_HOPS=1

# Optional, self-hosted only: 1 lets WordPress migration sources and SMTP
# servers use private, loopback and CGNAT addresses or .local/.internal names,
# for example an intranet WordPress or a mail relay on the same network. All
# other outbound requests stay public-only, and link-local addresses (including
# cloud metadata) stay blocked. Leave unset unless every portal user is trusted
# to reach this host's network.
# TYPEROLL_ALLOW_PRIVATE_NETWORK_FETCH=1

# compose.yaml passes this file to every Core role but blanks the secrets a
# role never uses: Forms keeps only Firebase Admin, FORMS_HMAC_SECRET and
# INTEGRATIONS_SECRET_KEY; the worker gets no preview or MCP OAuth signing key.

# Worker tuning. Defaults are safe for the one-worker reference profile.
DEPLOY_MAX_CONCURRENT=1
DEPLOY_WORKER_POLL_MS=2000
DEPLOY_WORKER_LEASE_MS=1800000
DEPLOY_WORKER_MAX_ATTEMPTS=5
PUBLISH_SWEEP_INTERVAL_MS=60000
