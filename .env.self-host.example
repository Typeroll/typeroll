# Secrets for the Cloudflare self-host profile (scripts/self-host-cloudflare.mjs).
# Copy to .env.self-host, fill in, and `chmod 600 .env.self-host`. The file is
# read by name only; values are sent to Cloudflare as Worker secrets and are
# never printed. Public settings belong in self-host.cloudflare.json instead.
# Wrap JSON values in single quotes; write a PEM key in double quotes with \n
# for each line break.
#
# The deploy token is NOT read from this file: export CLOUDFLARE_DEPLOY_API_TOKEN
# in the shell that runs plan/apply.

# ── Required (portal) ───────────────────────────────────────────────────────
# Signs sessions and encrypts identity data. At least 32 characters.
AUTH_SECRET=
# Account mail (confirmation, password reset): a provider as JSON, for example
# '{"type":"smtp","from":"CMS <cms@example.org>","config":{"host":"smtp.example.org","port":587,"secure":false,"user":"…","password":"…"}}'
ACCOUNT_EMAIL=
# Random secrets, at least 32 characters each.
FORMS_HMAC_SECRET=
PREVIEW_HMAC_SECRET=
INTEGRATIONS_SECRET_KEY=
MCP_OAUTH_SIGNING_KEY=
# P-256 private JWK (one line) that signs Extension tokens; see the self-hosting guide.
EXTENSION_SIGNING_PRIVATE_JWK=
# R2 API token (Object Read & Write) for the media and private-drafts buckets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# API token the portal uses for the installation's own Cloudflare account
# (site hosting and Web Analytics). Not the deploy token.
CLOUDFLARE_API_TOKEN=
# Sign in with GitHub.
GITHUB_SIGNIN_CLIENT_ID=
GITHUB_SIGNIN_CLIENT_SECRET=
# Your own publishing GitHub App and Cloudflare OAuth client (their public
# IDs go in "vars" of self-host.cloudflare.json).
TYPEROLL_PUBLISH_GITHUB_CLIENT_SECRET=
TYPEROLL_PUBLISH_GITHUB_PRIVATE_KEY=
TYPEROLL_PUBLISH_CLOUDFLARE_CLIENT_SECRET=
# Previous Extension signing keys while a rotation is in progress.
EXTENSION_SIGNING_PREVIOUS_PUBLIC_JWKS=
PAGESPEED_API_KEY=
SCRAPER_API_KEY=
# Opens the store transfer endpoint for backup and restore. Set it (at least
# 32 characters) only while you back up or restore, then remove it again.
TYPEROLL_STORE_TRANSFER_TOKEN=
