{
  "name": "typeroll",
  "version": "0.1.2",
  "private": true,
  "description": "Open-source CMS for building and operating static websites",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace=@typeroll/portal",
    "dev:site": "npm run dev --workspace=@typeroll/site-template",
    "dev:docs": "npm run dev --workspace=@typeroll/docs-site",
    "build:portal": "npm run build --workspace=@typeroll/portal",
    "build:site": "npm run build --workspace=@typeroll/site-template",
    "build:docs": "npm run build --workspace=@typeroll/docs-site",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:infra && npm run test --workspaces --if-present",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "core:release:verify": "node scripts/verify-core-release.mjs",
    "self-host:check": "node scripts/self-host-doctor.mjs",
    "self-host:bootstrap": "node scripts/self-host-bootstrap.mjs",
    "self-host:migrate": "node scripts/self-host-migrate.mjs",
    "self-host:backup": "node scripts/self-host-backup.mjs",
    "self-host:restore": "node scripts/self-host-restore.mjs",
    "self-host:gcp:plan": "node scripts/self-host-gcp-plan.mjs",
    "self-host:gcp:apply": "node scripts/self-host-gcp-apply.mjs",
    "self-host:gcp:doctor": "node scripts/self-host-gcp-doctor.mjs",
    "e2e:personas": "node scripts/e2e-personas.mjs",
    "e2e:target:check": "node scripts/e2e-target-check.mjs",
    "test:infra": "node --test scripts/*.test.mjs",
    "test:e2e": "npm run test:e2e --workspace=@typeroll/portal",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:extensions": "node scripts/smoke-extensions.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "firebase-admin": "14.3.0",
    "google-auth-library": "10.9.1"
  }
}
