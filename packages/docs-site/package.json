{
  "name": "@typeroll/docs-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run sync:extension-schema",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run check:extension-schema && astro check",
    "sync:extension-schema": "node scripts/sync-extension-schema.mjs",
    "check:extension-schema": "node scripts/sync-extension-schema.mjs --check",
    "format": "prettier --write \"src/**/*.{md,mdx,astro}\"",
    "format:check": "prettier --check \"src/**/*.{md,mdx,astro}\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.7",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.0"
  }
}
