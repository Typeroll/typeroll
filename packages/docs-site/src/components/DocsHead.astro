---
import DefaultHead from "@astrojs/starlight/components/Head.astro";

const route = Astro.locals.starlightRoute;
const url = new URL(Astro.url.pathname, Astro.site);
const docsHome = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const homeUrl = new URL(docsHome, Astro.site);
const home = url.pathname === docsHome;
const notFound = route.entry.data.title === "404";
const data = home
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Typeroll CMS",
      applicationCategory: "ContentManagementSystem",
      operatingSystem: "Web browser",
      url: "https://typeroll.com/",
      description:
        "An open-source CMS for static websites, with a visual editor and API and MCP access for AI agents.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        description:
          "Open-source software; hosting and connected services are separate.",
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Documentation",
          item: homeUrl.href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: route.entry.data.title,
          item: url.href,
        },
      ],
    };
---

<DefaultHead />
<link
  rel="alternate"
  type="text/plain"
  title="Documentation index for AI agents"
  href={new URL("llms.txt", homeUrl).href}
/>
{
  !notFound && (
    <link
      rel="alternate"
      type="text/plain"
      title="Read this page as text"
      href={new URL("index.txt", url).href}
    />
  )
}
{
  notFound ? (
    <meta name="robots" content="noindex" />
  ) : (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
    />
  )
}
