---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import movedBlockAnchors from "../data/moved-block-anchors.json";

const route = Astro.locals.starlightRoute;
const url = new URL(Astro.url.pathname, Astro.site);
const docsHome = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const homeUrl = new URL(docsHome, Astro.site);
const home = url.pathname === docsHome;
const notFound = route.entry.data.title === "404";
const shareImage = new URL("images/typeroll-docs-share.png", homeUrl).href;
// The block reference was split into several pages. Old links such as
// /tools/blocks/#block-parts are sent to the section's new page.
const blockAnchorRedirect = route.id === "tools/blocks"
  ? `(function(){var m=${JSON.stringify(movedBlockAnchors)};var t=m[decodeURIComponent(location.hash.slice(1))];if(t)location.replace(t);})();`
  : null;
const data = home
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Typeroll CMS",
      applicationCategory: "ContentManagementSystem",
      operatingSystem: "Web browser",
      url: "https://typeroll.com/",
      description:
        "An open-source CMS for static websites, with a visual editor and API and MCP access for AI agents.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        description:
          "Open-source software; hosting and connected services are separate.",
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Documentation",
          item: homeUrl.href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: route.entry.data.title,
          item: url.href,
        },
      ],
    };
---

<DefaultHead />
{blockAnchorRedirect && <script is:inline set:html={blockAnchorRedirect} />}
<meta property="og:image" content={shareImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Typeroll documentation" />
<meta name="twitter:image" content={shareImage} />
<link
  rel="alternate"
  type="text/plain"
  title="Documentation index for AI agents"
  href={new URL("llms.txt", homeUrl).href}
/>
{
  !notFound && (
    <link
      rel="alternate"
      type="text/plain"
      title="Read this page as text"
      href={new URL("index.txt", url).href}
    />
  )
}
{
  notFound ? (
    <meta name="robots" content="noindex" />
  ) : (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
    />
  )
}
