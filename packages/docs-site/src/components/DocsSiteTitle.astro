---
const docsHome = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<div class="brand-navigation">
  <a
    class="wordmark"
    href="https://typeroll.com/"
    aria-label="Typeroll CMS home"
  >
    <img
      class="light-logo"
      src={`${docsHome}brand/typeroll-main.svg`}
      alt="Typeroll"
      width="140"
      height="30"
    />
    <img
      class="dark-logo"
      src={`${docsHome}brand/typeroll-main-white.svg`}
      alt="Typeroll"
      width="140"
      height="30"
    />
  </a>
  <span class="beta">Beta</span>
  <a class="docs-home" href={docsHome}>Docs</a>
</div>
<style>
  .brand-navigation {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
  }
  .wordmark {
    display: flex;
    align-items: center;
    padding: 0.25rem 0;
    text-decoration: none;
  }
  .wordmark img {
    width: 140px;
    height: auto;
  }
  .light-logo {
    display: none;
  }
  :global([data-theme="light"]) .light-logo {
    display: block;
  }
  :global([data-theme="light"]) .dark-logo {
    display: none;
  }
  .beta {
    font:
      600 0.58rem/1.3 system-ui,
      sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.32rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 3px;
    color: var(--sl-color-gray-2);
  }
  .docs-home {
    font-size: 0.85rem;
    color: var(--sl-color-text-accent);
    border-left: 1px solid var(--sl-color-gray-4);
    padding-left: 0.65rem;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 380px) {
    .brand-navigation {
      gap: 0.4rem;
    }
    .wordmark img {
      width: 110px;
    }
    .docs-home {
      padding-left: 0.4rem;
      font-size: 0.8rem;
    }
  }
</style>
