# Anthropic key for the AI chat. The portal degrades gracefully when missing —
# the chat just returns an explanatory message — so this is optional for
# local development.
ANTHROPIC_API_KEY=

# Firebase service account JSON (single line, full JSON object). When set,
# the portal switches from the local fixtures backend to Firestore and
# requires real auth.
FIREBASE_SERVICE_ACCOUNT=

# Firebase client config for browser-side auth.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloudflare R2 + CDN for media uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: override the local-fixtures directory.
TYPEROLL_FIXTURES_DIR=

# HMAC secret used to sign form submission tokens. Required for the public
# /api/forms/submit endpoint to accept anything. Must be at least 32 chars.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FORMS_HMAC_SECRET=

# AES-256-GCM key for encrypting site-level integration secrets at rest (e.g.
# the Postmark server token / SMTP password used by form email notifications).
# Required to save an email connector. Must be at least 32 chars.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INTEGRATIONS_SECRET_KEY=

# Public URL of the portal — used to build the form action URL in tokens
# returned by /api/sites/{siteId}/forms/{formId}/token. Defaults to relative
# paths if unset (works only when the customer's site is served from the
# same origin as the portal, which is unusual).
PORTAL_PUBLIC_URL=

# Cloudflare account credentials. CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
# are needed for any CF integration to work. The token needs:
#   - Account / Cloudflare Pages / Edit   (create projects, deploy, attach domains)
#   - Zone    / DNS                / Edit (write fallback subdomain CNAMEs)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Legacy: single shared CF Pages project for ALL sites. Capped at CF's 100
# domains/project limit. Leave unset to use the per-site project model
# (recommended): each site gets its own project provisioned at site-create
# time via the Cloudflare API.
CLOUDFLARE_PAGES_PROJECT=

# Base hostname for the auto-provisioned per-site fallback subdomain
# (e.g. "sites.typeroll.com"). When set, every new site gets a
# <siteId>.<base> CNAME pointing at its CF Pages project, so the
# customer can preview before pointing their real DNS at us. The zone
# must be on Cloudflare and reachable by the API token's DNS:Edit scope.
SITES_BASE_DOMAIN=

# Optional: scraping service used as a fallback during WP migration when
# plain fetch() can't reach the public page (bot blocking, residential-IP
# requirement, JS-heavy rendering). When SCRAPER_API_URL is unset, the
# migration uses built-in fetch only.
#
#   SCRAPER_FORMAT       "get" (default) or "post"
#                        get:  GET {URL}?url={target}&key={key}
#                        post: POST {URL} with JSON {url}, key in Authorization
#   SCRAPER_RESPONSE_PATH  Dotted path to HTML in a JSON response, e.g. "data.html"
SCRAPER_API_URL=
SCRAPER_API_KEY=
SCRAPER_FORMAT=
SCRAPER_RESPONSE_PATH=

# Deploy job queue. "in_process" (default) runs each deploy as a
# fire-and-forget Promise — fine for local development. "cloud_tasks"
# enqueues to Google Cloud Tasks, which posts to /api/internal/deploy-worker.
# Required for Cloud Run because the in-process Promise can be killed when
# the launching request returns. See docs/deployment.md for setup.
DEPLOY_QUEUE=in_process

# Cloud Tasks queue (full resource name).
# Example: projects/my-project/locations/europe-west1/queues/deploy-staging
CLOUD_TASKS_QUEUE=

# Service account email Cloud Tasks uses to sign the OIDC token attached
# to the deploy-worker request. The worker verifies the token's email
# claim matches this exactly.
CLOUD_TASKS_SERVICE_ACCOUNT=

# Public URL of POST /api/internal/deploy-worker on the running portal.
# Used both as the Cloud Tasks target and as the OIDC token audience.
DEPLOY_WORKER_URL=

# Set to "1" only when poking the worker route from curl during local
# development. Bypasses OIDC verification. NEVER set in any deployed env.
DEPLOY_WORKER_SKIP_AUTH=
