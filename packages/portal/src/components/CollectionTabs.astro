---
interface Props {
  base: string;
  active: 'posts' | 'schema' | 'templates';
  itemCount?: number;
  fieldCount?: number;
  /**
   * System collections (Pages today; possibly Forms or Submissions later) have a built-in,
   * non-editable schema and no template story — render the Schema tab in read-only mode and
   * hide the Templates tab entirely.
   */
  system?: boolean;
}
const { base, active, itemCount, fieldCount, system = false } = Astro.props;
---
<nav class="ctabs" aria-label="Collection tabs">
  <a href={`${base}/posts`} class:list={["ctabs__tab", active === 'posts' && 'is-active']}>
    <span>Posts</span>
    {typeof itemCount === 'number' && <span class="ctabs__count">{itemCount}</span>}
  </a>
  <a href={`${base}/schema`} class:list={["ctabs__tab", active === 'schema' && 'is-active']}>
    <span>Schema</span>
    {typeof fieldCount === 'number' && <span class="ctabs__count">{fieldCount}</span>}
    {system && <span class="ctabs__badge" title="System schema — read-only">system</span>}
  </a>
  {!system && (
    <span class="ctabs__tab ctabs__tab--disabled" aria-disabled="true" title="Coming soon">
      <span>Templates</span>
      <span class="ctabs__soon">soon</span>
    </span>
  )}
</nav>

<style>
  .ctabs {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ctabs::-webkit-scrollbar { display: none; }
  .ctabs__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .ctabs__tab:hover { color: var(--color-text); text-decoration: none; }
  .ctabs__tab.is-active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }
  .ctabs__tab--disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .ctabs__tab--disabled:hover { color: var(--color-text-muted); }
  .ctabs__count {
    font-size: 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    padding: 1px 7px;
    border-radius: 999px;
    font-weight: 500;
    line-height: 1.4;
  }
  .ctabs__badge,
  .ctabs__soon {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
</style>
