---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getSession } from '../../../lib/auth';
import { listPersonalConnections } from '../../../lib/api-keys';
import { publicMcpUrl } from '../../../lib/mcp-consent';
import PersonalApiToken from '../../../components/PersonalApiToken.tsx';
import McpConnectLinks from '../../../components/McpConnectLinks.tsx';
import { mcpClientLinks } from '@typeroll/shared';
import { personalOrganizations } from '../../../lib/personal-site-access';
const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/login');
Astro.response.headers.set('Cache-Control', 'no-store');
const connections = await listPersonalConnections(session.userId);
const date = (value: string) => new Date(value).toLocaleDateString('en-GB');
const describe = (connection: (typeof connections)[number]) => [
  connection.kind === 'api_token' ? 'API token' : 'AI connection',
  `Created ${date(connection.created_at)}`,
  connection.revoked_at ? 'Revoked' : connection.expires_at && Date.parse(connection.expires_at) > Date.now() ? `Expires ${date(connection.expires_at)}` : connection.expires_at ? 'Expired' : 'Active until revoked',
  ...(connection.last_used_at ? [`Last used ${date(connection.last_used_at)}`] : []),
  ...(connection.read_only ? ['Read only'] : []),
  ...(connection.allowed_org_ids ? [`Organizations: ${connection.allowed_org_ids.join(', ')}`] : []),
].join(' · ');
const organizations = (await personalOrganizations(session.userId)).map(org => ({ id: org.id, name: org.name ?? org.id }));
const endpoint = publicMcpUrl(Astro.request);
const links = mcpClientLinks(endpoint);
---
<AppLayout title="AI connections">
  <div class="stack" style="max-width: 760px;">
    <h1>AI connections</h1>
    <p>Use your usual AI assistant to work on Typeroll. Connect it once, sign in and approve access.</p>
    <McpConnectLinks client:load endpoint={endpoint} links={links} />
    <p>Then tell your assistant which site to work on. It confirms the organization, site and version before reading or changing content. Each conversation keeps its own selection.</p>
    <p>Your connection follows your current access across all organizations. Editors can create pages, custom block types and shared Page templates. Administrative settings still require administrator access.</p>
    <p><a href="https://typeroll.com/docs/guides/ai-connections/" target="_blank" rel="noopener noreferrer">Connection instructions and workflow skills ↗</a></p>
    {Astro.url.searchParams.has('revoked') && <p role="status">Connection revoked. Its access and refresh tokens no longer work.</p>}
    <h2>Your connections and tokens</h2>
    {connections.length === 0 && <p class="muted">No personal AI connections or API tokens yet.</p>}
    {connections.map(connection => {
      return <section class="card stack">
        <h3 style="overflow-wrap:anywhere;">{connection.name}</h3>
        <p class="muted">{describe(connection)}</p>
        {!connection.revoked_at && <form action="/api/account/ai-connections" method="POST">
          <input type="hidden" name="connection_id" value={connection.id} />
          <button class="btn btn--ghost" type="submit">Revoke connection</button>
        </form>}
      </section>;
    })}
    <PersonalApiToken client:load organizations={organizations} />
    <p>See <a href="https://typeroll.com/docs/guides/rest-api/" target="_blank" rel="noopener noreferrer">Use the REST API ↗</a> for examples with several organizations.</p>
    <p>Manual keys remain available in <a href="/app/settings/api-keys">API keys</a>. Revoking a personal connection does not change other connections or API keys.</p>
  </div>
</AppLayout>
