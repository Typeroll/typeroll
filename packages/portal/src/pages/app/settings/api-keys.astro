---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getSession } from '../../../lib/auth';
import { listApiKeys } from '../../../lib/api-keys';
import { requireOrganizationOwnerOrAdmin } from '../../../lib/access';
import OrgApiKeyManager from '../../../components/OrgApiKeyManager.tsx';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/login');
const orgId = session.orgId;
if (!orgId) return Astro.redirect('/onboarding');

// Organization keys act with organization-wide authority, so only owners and
// admins may see or manage them, matching /api/orgs/api-keys.
const guard = await requireOrganizationOwnerOrAdmin(Astro.cookies, 'Only Organization owners and admins can manage organization API keys.');
const canManage = guard.ok;
const keys = canManage ? await listApiKeys(orgId, null) : [];
const summaries = keys.map((k) => ({
  id: k.id,
  name: k.name,
  created_at: k.created_at,
  created_by: k.created_by,
  last_used_at: k.last_used_at,
  last_used_ip: k.last_used_ip,
  revoked_at: k.revoked_at,
}));
---
<AppLayout title="Org API keys">
  <div class="app-header">
    <h1>Org API keys</h1>
    <p class="muted text-sm" style="max-width: 720px;">
      For a remote MCP connection, enter your portal’s <code>/api/mcp</code> URL in your AI tool and approve access in your browser. No key copying is needed. New OAuth connections are personal and managed under Account → AI connections. Older organization connections remain listed here. Manual API keys remain available for REST, CLI and the <code>@typeroll/mcp-server</code> stdio install. Site-specific keys and older connections are managed in each site’s settings.
    </p>
  </div>

  <div style="max-width: 760px;">
    {canManage
      ? <OrgApiKeyManager client:load initialKeys={summaries} />
      : <p class="muted">Only Organization owners and admins can manage organization API keys.</p>}
  </div>

  <p class="text-sm muted" style="margin-top: 1.5rem;">
    <a href="/app/settings">← Back to account settings</a>
  </p>
</AppLayout>
