---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getSession } from '../../../lib/auth';
import { releaseManifest } from '../../../lib/release';
import { organizationMembership } from '../../../lib/organization-session';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/login');
const orgId = session.orgId;
if (!orgId) return Astro.redirect('/onboarding');
const typerollVersion = releaseManifest().core_version;
const membership = await organizationMembership(session.userId, orgId);
const canManagePublishing = membership?.role === 'owner' || membership?.role === 'admin';
---
<AppLayout title="Account">
  <div class="app-header">
    <h1>Account</h1>
  </div>

  <div class="card stack" style="max-width: 720px;">
    <div class="field"><label>Email</label><input value={session.email} disabled /></div>
    <div class="field"><label>Organization</label><input value={orgId} disabled /></div>
    <p class="muted text-sm">
      Team management, billing, and white-label settings are in the roadmap.
    </p>
  </div>

  <section class="card stack" style="max-width: 720px; margin-top: 1rem;">
    <h2>GitHub &amp; Cloudflare</h2>
    <p>Connect accounts for <strong>{membership?.name ?? 'your organization'}</strong>. Reuse the connections for all its sites: GitHub for generated source, Cloudflare for static hosting and R2 image storage.</p>
    {canManagePublishing ? <div><a class="btn" href="/app/settings/publishing">Connect GitHub &amp; Cloudflare</a></div> :
      <p class="muted">Ask an organization owner or admin to connect these accounts.</p>}
  </section>

  <p class="muted text-sm" style="margin-top: 1rem;">
    Looking for API keys? They have their own page in the sidebar now — <a href="/app/settings/api-keys">Account → API keys</a>.
  </p>

  <p class="muted" style="margin-top: 3rem; font-size: 0.75rem;" data-typeroll-version>
    Typeroll v{typerollVersion}
  </p>
</AppLayout>
