---
import AppLayout from '../../../layouts/AppLayout.astro';
import PublishingConnections from '../../../components/PublishingConnections';
import { publishingAdmin } from '../../../lib/publishing/http';

const guard = await publishingAdmin(Astro);
if (!guard.ok) return guard.response;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<AppLayout title="Publishing accounts">
  <div class="app-header"><h1>Publishing accounts</h1></div>
  <PublishingConnections client:load />
</AppLayout>
