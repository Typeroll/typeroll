---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import FontLibrary from '../../../../../components/FontLibrary.tsx';
import { loadSiteContext } from '../../../../../lib/access';
import { vstore } from '../../../../../lib/version-store';
import { defaultSiteSettings, isArchivedSite } from '@typeroll/shared';

// The site's Fonts library. Everyone with access sees it; uploading, editing
// and deleting need the same permission as the site settings (a site admin,
// and not on an archived site). The list loads from the fonts API.
const ctx = await loadSiteContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { site, versionId, owner_org_id: orgId } = ctx;
const settings = (await vstore.settings(orgId, site.id, versionId)) ?? defaultSiteSettings;
const canEdit = ctx.permission === 'admin' && !isArchivedSite(site);
---
<AppLayout title={`Fonts — ${site.name}`} siteId={site.id}>
  <FontLibrary client:load siteId={site.id} canEdit={canEdit} language={settings.language} />
</AppLayout>
