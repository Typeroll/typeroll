---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { vstore } from '../../../../../lib/version-store';
import PartialEditor from '../../../../../components/PartialEditor.tsx';
import TemplateEditor from '../../../../../components/TemplateEditor.tsx';
import { loadSiteContext } from '../../../../../lib/access';
import { getStore } from '../../../../../lib/datastore';
import { readWorkingCopy } from '../../../../../lib/working-copy';
import { paths, resolveRenderVersion } from '@typeroll/shared';
import type { PageTemplate, Partial as PartialDoc, Site, SiteVersion } from '@typeroll/shared';

const ctx = await loadSiteContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { session, site, versionId, owner_org_id: orgId } = ctx;
const siteId = site.id;
const { partialId } = Astro.params;
if (!partialId) return Astro.redirect('/app');

const store = getStore();

const partial = await vstore.partial(orgId, siteId, versionId, partialId);
const inferKind: PartialDoc['kind'] =
  partialId === 'header' ? 'header' : partialId === 'footer' ? 'footer' : 'free';
const defaultDoc: PartialDoc = partial ?? {
  id: partialId,
  name: partialId === 'header' ? 'Main Header' : partialId === 'footer' ? 'Main Footer' : partialId,
  kind: inferKind,
  content_mode: 'html',
  status: 'draft',
  html_content: '',
};
// Block-mode partials (free global blocks, header and footer) open in the
// block-tree editor with the same draft handling; HTML partials keep the
// HTML editor.
const useBlockEditor = defaultDoc.content_mode === 'blocks';
const editorSettings = useBlockEditor ? await vstore.settings(orgId, siteId, versionId) : null;
const kindLabel = defaultDoc.kind === 'free' ? 'Free block' : defaultDoc.kind === 'header' ? 'Header' : 'Footer';
const workingCopy = await readWorkingCopy(
  { orgId, siteId, versionId },
  { kind: 'partial', id: partialId },
);
const versionDoc = await store.getDoc<SiteVersion>(paths.version(orgId, siteId, versionId));
// Compare edits with the build snapshot, not its later completion time.
const lastDeployedAt = versionDoc?.last_deployed_content_at ?? versionDoc?.last_deployed_at ?? null;
const globalBlockSummaries = (await vstore.partials(orgId, siteId, versionId)).filter(partial => partial.kind === 'free')
  .map(partial => ({ id: partial.id, name: partial.name, status: partial.status, content_mode: partial.content_mode }));
---
<AppLayout title={`${defaultDoc.name} — ${site.name}`} siteId={siteId} bare={useBlockEditor}>
  {defaultDoc.content_mode !== 'blocks' && <div class="app-header">
    <div>
      <a href={`/app/sites/${siteId}/partials`} class="muted text-sm">← Global blocks</a>
      <h1>{defaultDoc.name}</h1>
      <p class="muted">{kindLabel}</p>
    </div>
  </div>}
  {useBlockEditor
    ? <TemplateEditor globalBlocks={globalBlockSummaries} client:load kind="global_block" partialKind={defaultDoc.kind} siteId={siteId} responsiveBreakpoints={editorSettings?.responsive_breakpoints} siteStyles={editorSettings?.styles ?? []} renderVersion={resolveRenderVersion(editorSettings?.render_version)} template={{ id: defaultDoc.id, name: defaultDoc.id, label: defaultDoc.name, status: defaultDoc.status, blocks: (workingCopy?.fields?.blocks as PartialDoc['blocks']) ?? defaultDoc.blocks ?? [] } as unknown as PageTemplate} pendingDraft={!!workingCopy} />
    : <PartialEditor client:load siteId={siteId} partial={defaultDoc} workingCopy={workingCopy} lastDeployedAt={lastDeployedAt} />}
</AppLayout>
