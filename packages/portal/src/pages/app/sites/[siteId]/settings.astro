---
import { SITE_SETTINGS_SECTIONS, isSiteSettingsSection } from '../../../../lib/site-settings-sections';
import AppLayout from '../../../../layouts/AppLayout.astro';
import { vstore } from '../../../../lib/version-store';
import { loadSiteContext } from '../../../../lib/access';
import { TOKEN_SCALES, defaultSiteSettings, resolveBreakpointWidths, BREAKPOINTS_ABOVE_MOBILE, isArchivedSite, renderVersionStatus, resolveRenderVersion, RENDER_VERSIONS } from '@typeroll/shared';
import RenderVersionSettings from '../../../../components/RenderVersionSettings';
import OnColorFields from '../../../../components/OnColorFields';
import DomainManager from '../../../../components/DomainManager.tsx';
import { SiteHostingGroup } from '../../../../components/HostingGroups';
import ManagedPublishingMigration from '../../../../components/ManagedPublishingMigration';
import PublishingDomains from '../../../../components/PublishingDomains';
import { organizationMembership } from '../../../../lib/organization-session';

const ctx = await loadSiteContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { session, site, versionId, owner_org_id: orgId } = ctx;
const siteId = site.id;
const requestedSection = Astro.url.searchParams.get('section');
const section = isSiteSettingsSection(requestedSection) ? requestedSection : 'general';
const sectionInfo = SITE_SETTINGS_SECTIONS.find(item => item.id === section)!;

const membership = session.orgId === orgId ? await organizationMembership(session.userId, orgId) : null;
const canManagePublishing = membership?.role === 'owner' || membership?.role === 'admin';

const settings = (await vstore.settings(orgId, siteId, versionId)) ?? defaultSiteSettings;
const archived = isArchivedSite(site);
const render = renderVersionStatus(settings.render_version);
// Same gate as POST /api/sites/{siteId}/render-version.
const canChangeRendering = ctx.permission === 'admin' && !archived;
// Archiving refuses a site that is still answering on a customer domain, so
// the page says that up front instead of offering a button that 409s.
const domainBlocksArchiving =
  Boolean(site.domain) && (site.domain_status === 'live' || site.domain_status === 'verified');
---
<AppLayout title={`Settings — ${site.name}`} siteId={siteId}>
  <div class="app-header">
    <h1>Site settings</h1>
  </div>

  <div class="settings-navigation">
    <nav aria-label="Site settings sections">
      {SITE_SETTINGS_SECTIONS.map(item => <a href={`?section=${item.id}`} data-settings-link={item.id} aria-current={section === item.id ? 'page' : undefined}>{item.label}<span data-settings-dirty={item.id} hidden aria-label="Unsaved changes"> •</span></a>)}
    </nav>
    <div class="settings-mobile-nav field"><label for="settings-section">Settings section</label>
      <select id="settings-section">{SITE_SETTINGS_SECTIONS.map(item => <option value={item.id} selected={item.id === section}>{item.label}</option>)}</select>
    </div>
  </div>
  <p class="muted" id="settings-description">{sectionInfo.description}</p>
  {archived ? <p class="muted">This site is archived. Restore it under Advanced to edit its settings.</p> : ctx.permission !== 'admin' && <p class="muted">A site admin can change these settings.</p>}

  <section data-settings-section="publishing" hidden={section !== 'publishing'} class="card stack" style="max-width: 720px; margin-bottom: 1rem;">
    <h2 style="font-size: 1.125rem;">Publishing</h2>
    <p>GitHub and media are shared by the organization. Hosting Groups connect the accounts that host its sites. The organization manages the shared build engine.</p>
    {site.publishing_mode === 'customer_git' && <SiteHostingGroup siteId={siteId} client:load />}
    {site.publishing_mode !== 'customer_git' && site.hosting_adapter === 'cloudflare' && site.hosting_config?.pages_project && canManagePublishing && <ManagedPublishingMigration siteId={siteId} client:load />}
    {canManagePublishing ? <div><a class="btn" href="/app/settings/publishing">Open Publishing</a></div> :
      <p class="muted">An owner or admin of this site's organization manages its publishing accounts.</p>}
  </section>

  <div data-settings-section="publishing" hidden={section !== 'publishing'}>
  <!--
    Domain lifecycle component sits outside the settings form so adding
    a hostname doesn't accidentally flip the live URL — the customer
    must walk through pending → verified → live. See
    docs/domain-lifecycle-plan.md.
  -->
  {site.publishing_mode === 'customer_git' ? <PublishingDomains siteId={siteId} client:load /> : <div class="card stack" style="max-width: 720px; margin-bottom: 1rem;">
    <h2 style="font-size: 1.125rem;">Custom domain</h2>
    <DomainManager
      client:load
      siteId={siteId}
      fallbackUrl={site.hosting_config?.fallback_subdomain ? `https://${site.hosting_config.fallback_subdomain}` : undefined}
    />
  </div>}

  </div>

  <form id="site-settings-form" method="POST" action={`/api/sites/${siteId}/settings`} class="stack" style="max-width: 720px;">
    <input type="hidden" name="settings_section" value={section} />
    <fieldset disabled={ctx.permission !== 'admin' || archived} class="settings-fields">
    <div class="card stack" data-settings-section="general" hidden={section !== 'general'}>
      <h2 style="font-size: 1.125rem;">Identity</h2>
      <div class="field">
        <label for="setting-site_name">Site name</label>
        <input id="setting-site_name" name="site_name" value={settings.site_name} required />
      </div>
      <div class="field">
        <label for="setting-tagline">Tagline</label>
        <input id="setting-tagline" name="tagline" value={settings.tagline ?? ''} />
      </div>
      <div class="field">
        <label for="setting-logo">Logo URL</label>
        <input id="setting-logo" name="logo" value={settings.logo ?? ''} placeholder="https://cdn.example.com/sites/.../logo.png" />
      </div>
      <div class="field">
        <label for="setting-favicon">Favicon URL</label>
        <input id="setting-favicon" name="favicon" value={settings.favicon ?? ''} />
      </div>
      <div class="field">
        <label for="setting-apple_touch_icon">Apple touch icon URL <span class="muted text-sm">(180×180 PNG, home-screen bookmarks)</span></label>
        <input id="setting-apple_touch_icon" name="apple_touch_icon" value={settings.apple_touch_icon ?? ''} />
      </div>
      <div class="field">
        <label for="setting-icon_192">192×192 app icon URL</label>
        <input id="setting-icon_192" name="icon_192" value={settings.icon_192 ?? ''} />
      </div>



    </div>

    <div class="card stack" data-settings-section="publishing" hidden={section !== 'publishing'}>
      <h2 style="font-size: 1.125rem;">Preview address</h2>
      <div class="field">
        <label for="setting-staging_url">Staging URL <span class="muted">(optional)</span></label>
        <input id="setting-staging_url" name="staging_url" value={site.staging_url ?? ''} placeholder="https://staging.example.com" />
        <p class="muted text-sm">Where preview deploys go before promotion to the live domain. Defaults to the fallback subdomain.</p>
      </div>
    </div>

    <div class="card stack" data-settings-section="design" hidden={section !== 'design'}>
      <h2 style="font-size: 1.125rem;">Colors</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
        {(['primary', 'secondary', 'accent', 'background', 'surface', 'text', 'text_light'] as const).map(key => (
          <div class="field">
            <label for={`setting-color-${key}`}>{key.replace('_', ' ')}</label>
            <input id={`setting-color-${key}`} name={`colors.${key}`} type="color" value={settings.colors[key]} style="height: 40px; padding: 0.25rem;" />
          </div>
        ))}
      </div>
      <div class="field">
        <label>Surface hover (optional)</label>
        <input name="colors.surface_hover" value={settings.colors.surface_hover ?? ''} placeholder="Automatic: darker surface" />
        <p class="muted text-sm">Leave empty for a shade derived from surface and text. Use a hex colour to override it.</p>
      </div>
      <OnColorFields client:load colors={settings.colors} renderVersion={resolveRenderVersion(settings.render_version)} />
    </div>

    <div class="card stack" data-settings-section="design" hidden={section !== 'design'}>
      <h2 style="font-size: 1.125rem;">Typography</h2>
      <div class="field">
        <label for="setting-image_sizes_default">Default image <code>sizes</code></label>
        <input id="setting-image_sizes_default" name="image_sizes_default" value={settings.image_sizes_default ?? ''} placeholder="(max-width: 640px) 360px, 560px" />
        <p class="muted text-sm">Site-wide <code>sizes</code> for responsive images, telling the browser how wide images actually render so it picks the smallest sufficient variant. A page can override this, and a per-image <code>sizes</code> attribute wins over both. Leave blank for the generic <code>(max-width: 768px) 100vw, 800px</code> default.</p>
      </div>
      <details>
        <summary>Named typography and spacing scales</summary>
        <p>Blocks can use these step names instead of fixed pixels. Empty fields use the default shown. Changes apply to every block using that step.</p>
        {Object.entries(TOKEN_SCALES).map(([scale, steps]) => <fieldset>
          <legend>{scale.replace('_', ' ')}</legend>
          {Object.entries(steps).map(([step, fallback]) => <div class="field">
            <label>{step}</label><input name={`design_scales.${scale}.${step}`} value={settings.design_scales?.[scale as keyof typeof TOKEN_SCALES]?.[step] ?? ''} placeholder={fallback} />
          </div>)}
        </fieldset>)}
      </details>
      <details>
        <summary>Responsive block widths</summary>
        <p>Viewport width where each block editing range starts. Use increasing widths. These control authored responsive fields and block visibility; menu collapse and other explicit component thresholds remain separate.</p>
        {BREAKPOINTS_ABOVE_MOBILE.map(name => <div class="field"><label for={`responsive-${name}`}>{name} starts at (px)</label><input id={`responsive-${name}`} name={`responsive_breakpoints.${name}`} type="number" min="320" max="2560" step="1" required value={resolveBreakpointWidths(settings.responsive_breakpoints)[name]} /></div>)}
        <p>Defaults: 640, 1024, 1280 and 1536. Reload an open editor after changing these widths.</p>
      </details>
      <datalist id="font-families"><option value="system">System font (no download)</option><option value="Inter" /></datalist>
      <p>Use system for the visitor’s device font, or enter a Google Fonts family name.</p>
      <div class="field">
        <label for="setting-fonts-heading">Heading font</label>
        <input id="setting-fonts-heading" list="font-families" name="fonts.heading" value={settings.fonts.heading} />
      </div>
      <div class="field">
        <label for="setting-fonts-body">Body font</label>
        <input id="setting-fonts-body" list="font-families" name="fonts.body" value={settings.fonts.body} />
      </div>
      <div class="field">
        <label for="setting-fonts-size_base">Base font size (px)</label>
        <input id="setting-fonts-size_base" name="fonts.size_base" type="number" min="12" max="24" value={settings.fonts.size_base} />
      </div>
      <div class="field"><label>Monospace font</label><input list="font-families" name="fonts.mono" value={settings.fonts.mono ?? ''} placeholder="System monospace" /></div>
      <div class="field">
        <label for="fonts-smoothing">Font smoothing</label>
        <select id="fonts-smoothing" name="fonts.smoothing">
          <option value="" selected={!settings.fonts.smoothing}>Default for the render version ({resolveRenderVersion(settings.render_version) >= 6 ? 'browser default' : 'antialiased'})</option>
          <option value="auto" selected={settings.fonts.smoothing === 'auto'}>Browser default (auto)</option>
          <option value="antialiased" selected={settings.fonts.smoothing === 'antialiased'}>Antialiased (thinner text on macOS)</option>
        </select>
        <p class="muted text-sm">Antialiased can suit light text on a dark background. Dark text on a light background reads closer to other sites with the browser default.</p>
      </div>
    </div>

    <div class="card stack" data-settings-section="seo" hidden={section !== 'seo'}>
      <h2 style="font-size: 1.125rem;">SEO defaults</h2>
      <div class="field">
        <label for="setting-robots_txt">robots.txt (leave blank for default)</label>
        <textarea id="setting-robots_txt" name="robots_txt" rows="3" style="font-family: var(--font-mono);">{settings.robots_txt ?? ''}</textarea>
      </div>
      <div class="field">
        <label for="setting-default_seo_suffix">SEO title suffix</label>
        <input id="setting-default_seo_suffix" name="default_seo_suffix" value={settings.default_seo_suffix ?? ''} placeholder=" — Site Name" />
      </div>
      <div class="field">
        <label for="setting-trailing_slash">Trailing slash policy</label>
        <select id="setting-trailing_slash" name="trailing_slash">
          <option value="always" selected={(settings.trailing_slash ?? 'always') === 'always'}>Always (/about/)</option>
          <option value="never" selected={settings.trailing_slash === 'never'}>Never (/about)</option>
          <option value="ignore" selected={settings.trailing_slash === 'ignore'}>Preserve authored paths</option>
        </select>
      </div>
      <details>
        <summary>Routes served by another deployment</summary>
        <p class="muted text-sm">For sections hosted separately under this domain. List each exact path and its deployment owner, for example /docs/ | Documentation. This does not configure hosting or verify the other deployment. Verify those public URLs separately. Wildcards are not supported.</p>
        <div class="field"><label for="external-routes">Path | deployment owner (one per line)</label><textarea id="external-routes" name="external_routes">{settings.external_routes?.map(route => `${route.path} | ${route.owner}`).join('\n') ?? ''}</textarea></div>
      </details>
      <details>
        <summary>Editorial publication checks</summary>
        <p class="muted text-sm">Rules apply to every built page, including unchanged pages. Matches are warnings for review; Typeroll does not rewrite your content.</p>
        <div class="field"><label for="seo-markers">Internal phrases to flag (one per line)</label><textarea id="seo-markers" name="seo_review.forbidden_markers">{settings.seo_review?.forbidden_markers?.join('\n') ?? ''}</textarea></div>
        <div class="field"><label for="seo-claims">Claims needing review (phrase | review instruction, one per line)</label><textarea id="seo-claims" name="seo_review.claims">{settings.seo_review?.claims?.map(rule => `${rule.phrase} | ${rule.guidance}`).join('\n') ?? ''}</textarea></div>
        <div class="field"><label for="seo-notes">Editorial constraints for reviewers (one per line)</label><textarea id="seo-notes" name="seo_review.notes">{settings.seo_review?.notes?.join('\n') ?? ''}</textarea></div>
      </details>
      <label><input type="checkbox" name="sitewide_nofollow" checked={settings.sitewide_nofollow === true} /> Ask search engines not to follow links on this site (nofollow)</label>
      <p class="muted text-sm">Fallback values used when a page doesn't set its own SEO. Yoast/RankMath/SEOPress/AIOSEO equivalents.</p>
      <div class="field">
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
          <input
            type="checkbox"
            name="sitewide_noindex"
            checked={settings.sitewide_noindex === true}
            style="width: auto; margin: 0;"
          />
          <span>Hide every page from search engines (site-wide noindex)</span>
        </label>
        <p class="muted text-sm">Use for staging or review sites. This emits a noindex meta directive without changing robots.txt, so crawlers can still read the directive.</p>
      </div>
      <div class="field">
        <label for="setting-language">Language</label>
        <input id="setting-language" name="language" value={settings.language ?? 'en'} placeholder="en" />
        <p class="muted text-sm">BCP 47 tag — e.g. <code>en</code>, <code>sv</code>, <code>en-GB</code>. Sets the <code>&lt;html lang&gt;</code> attribute and the OpenGraph locale.</p>
      </div>
      <div class="field">
        <label for="setting-twitter_handle">Twitter / X handle</label>
        <input id="setting-twitter_handle" name="twitter_handle" value={settings.twitter_handle ?? ''} placeholder="acme" />
        <p class="muted text-sm">Without the @. Used for <code>twitter:site</code> and <code>twitter:creator</code> meta on share cards.</p>
      </div>
      <div class="field">
        <label for="setting-default_meta_description">Default meta description</label>
        <textarea id="setting-default_meta_description" name="default_meta_description" rows="2" placeholder="Used when a page has no description of its own.">{settings.default_meta_description ?? ''}</textarea>
      </div>
      <div class="field">
        <label for="setting-default_og_image">Default OpenGraph image URL</label>
        <input id="setting-default_og_image" name="default_og_image" value={settings.default_og_image ?? ''} placeholder="https://cdn.example.com/social-card.png" />
        <p class="muted text-sm">Shown when a page is shared on Facebook, LinkedIn, etc. and has no per-page og_image.</p>
      </div>

    </div>

    <div class="card stack" data-settings-section="seo" hidden={section !== 'seo'}>
      <h2 style="font-size: 1.125rem;">Organization schema</h2>
      <p class="muted text-sm">Emitted as JSON-LD on every page. Helps search engines pick the right brand info.</p>
      <div class="field">
        <label for="setting-organization-name">Organization name</label>
        <input id="setting-organization-name" name="organization.name" value={settings.organization?.name ?? ''} placeholder={settings.site_name} />
      </div>
      <div class="field">
        <label for="setting-organization-logo">Logo URL</label>
        <input id="setting-organization-logo" name="organization.logo" value={settings.organization?.logo ?? ''} placeholder="https://cdn.example.com/logo.png" />
      </div>
      <div class="field">
        <label for="setting-organization-same_as">Profile URLs (sameAs) — one per line</label>
        <textarea id="setting-organization-same_as" name="organization.same_as" rows="3" placeholder="https://www.linkedin.com/company/...&#10;https://www.facebook.com/...&#10;https://x.com/...">{(settings.organization?.same_as ?? []).join('\n')}</textarea>
      </div>
    </div>

    <div class="card stack" data-settings-section="integrations" hidden={section !== 'integrations'}>
      <h2 style="font-size: 1.125rem;">Cookies &amp; consent</h2>
      <details><summary>How cookie consent works</summary>
      <p class="muted text-sm">
        Show a blocking consent dialog on a visitor's first visit. We set a
        cookie (<code>tr_consent</code>) that remembers the choice for 12 months
        so the dialog doesn't reappear. The scripts below are injected according
        to that choice — Google Analytics, Meta Pixel and similar belong in
        "Optional scripts".
      </p>
      <p class="muted text-sm" style="margin-top: -0.5rem;">
        A small floating "Cookies" button appears bottom-left once the visitor
        has chosen, so they can change their mind. Want the link in the footer
        instead? Put <code>data-tr-open-consent</code> on any link or button in
        the footer partial, e.g.
        <code>&lt;a href="#" data-tr-open-consent&gt;Cookies&lt;/a&gt;</code>,
        and hide the floating button in Custom CSS with
        <code>.tr-consent__manage{'{'}display:none{'}'}</code>.
      </p>
      </details>
      <div class="field">
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
          <input
            type="checkbox"
            name="cookie_consent.enabled"
            checked={settings.cookie_consent?.enabled === true}
            style="width: auto; margin: 0;"
          />
          <span>Enable cookie consent on this site</span>
        </label>
      </div>
      <div class="field">
        <label for="setting-cookie_consent-text">Dialog text (HTML)</label>
        <textarea id="setting-cookie_consent-text" name="cookie_consent.text" rows="3" placeholder="We use cookies to improve your experience. Read more in our &lt;a href=&quot;/privacy&quot;&gt;privacy policy&lt;/a&gt;.">{settings.cookie_consent?.text ?? ''}</textarea>
        <p class="muted text-sm">Leave empty to use the built-in default text. You can put <code>&lt;a&gt;</code> links straight in here.</p>
      </div>
      <div class="field">
        <label for="setting-cookie_consent-privacy_policy_url">Privacy policy URL (optional)</label>
        <input id="setting-cookie_consent-privacy_policy_url"
          name="cookie_consent.privacy_policy_url"
          value={settings.cookie_consent?.privacy_policy_url ?? ''}
          placeholder="/privacy-policy"
        />
        <p class="muted text-sm">When set, a "Read our privacy policy" link appears under the text.</p>
      </div>
      <div class="field">
        <label for="setting-cookie_consent-scripts_necessary">Necessary scripts (always run)</label>
        <textarea id="setting-cookie_consent-scripts_necessary" name="cookie_consent.scripts_necessary" rows="3" style="font-family: var(--font-mono);">{settings.cookie_consent?.scripts_necessary ?? ''}</textarea>
        <p class="muted text-sm">
          Put <code>&lt;script&gt;</code> tags here that are strictly necessary,
          or that must load before consent (e.g. Google Consent Mode v2 with a
          default of <code>denied</code>).
        </p>
      </div>
      <div class="field">
        <label for="setting-cookie_consent-scripts_optional">Optional scripts (run only after "Accept all")</label>
        <textarea id="setting-cookie_consent-scripts_optional" name="cookie_consent.scripts_optional" rows="4" style="font-family: var(--font-mono);">{settings.cookie_consent?.scripts_optional ?? ''}</textarea>
        <p class="muted text-sm">
          Google Analytics, Meta Pixel, Hotjar, marketing cookies and the like.
          They render into the page but stay inert until the visitor accepts all
          cookies — at which point they activate without a reload.
        </p>
      </div>
      <div class="field">
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
          <input
            type="checkbox"
            name="cookie_consent.reload_after_consent"
            checked={settings.cookie_consent?.reload_after_consent === true}
            style="width: auto; margin: 0;"
          />
          <span>Reload the page after consent (if your scripts misbehave without it)</span>
        </label>
        <p class="muted text-sm">
          Leave unchecked for seamless activation without a reload. Check it if
          you use scripts that can't cope with being injected after page load
          (some older GTM containers, chat widgets).
        </p>
      </div>
    </div>

    <div class="card stack" data-settings-section="advanced" hidden={section !== 'advanced'}>
      <h2 style="font-size: 1.125rem;">Advanced</h2>
      <div class="field">
        <label for="setting-iframe_allowed_hosts">Additional iframe hosts <span class="muted text-sm">(one exact hostname per line)</span></label>
        <textarea id="setting-iframe_allowed_hosts" name="iframe_allowed_hosts" rows="4" placeholder="player.example.com">{(settings.iframe_allowed_hosts ?? []).join('\n')}</textarea>
      </div>
      <div class="field">
        <label for="setting-scripts_head">&lt;head&gt; scripts (analytics, etc.)</label>
        <textarea id="setting-scripts_head" name="scripts_head" rows="3">{settings.scripts_head ?? ''}</textarea>
      </div>
      <div class="field">
        <label for="setting-scripts_body_end">End-of-body scripts (chat widgets, etc.)</label>
        <textarea id="setting-scripts_body_end" name="scripts_body_end" rows="3">{settings.scripts_body_end ?? ''}</textarea>
      </div>
      <div class="field">
        <strong>Custom CSS</strong>
        <p class="muted">Site CSS is edited with syntax checks under <a href={`/app/sites/${site.id}/styles#site-css-title`}>Styles → Site CSS</a>.</p>
      </div>

    </div>

    <section class="card stack" data-settings-section="access" hidden={section !== 'access'}>
      <h2>AI agent instructions</h2>
      <p>Describe your audience, tone, terminology and editing conventions. Connected assistants can read these instructions for this site and version. Keep credentials and private personal information out.</p>
      <div class="field"><label for="agent-instructions">Site instructions</label>
      <textarea id="agent-instructions" name="agent_instructions" rows="6" maxlength="12000">{settings.agent_instructions ?? ''}</textarea></div>
      <p class="muted text-sm">Guidance does not grant permission to publish or change another site. Save settings to apply it.</p>
    </section>
    <div class="settings-save">
      <button type="submit" class="btn" id="settings-save-button">Save {sectionInfo.label}</button>
      <p role="status" id="settings-save-status" aria-live="polite">{Astro.url.searchParams.get('saved') === '1' ? 'Saved.' : ''}</p>
    </div>
    </fieldset>
  </form>

  <div data-settings-section="design" hidden={section !== 'design'} style="max-width: 720px; margin-top: 2rem;">
    <RenderVersionSettings client:load siteId={siteId} version={render.version} latest={render.latest} versions={[...RENDER_VERSIONS]} canChange={canChangeRendering} />
  </div>

  <div data-settings-section="access" hidden={section !== 'access'} style="max-width: 720px; margin-top: 2rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">AI block scripts</h2>
      <details><summary>About AI-authored scripts</summary>
      <p class="muted text-sm">
        Custom block types can ship client-side JavaScript that runs in every
        visitor's browser. By default, AI surfaces (chat, MCP agents, API keys)
        can build blocks with HTML + CSS only — scripts require a human to add
        them in the block type editor. Enable this to let AI author block
        scripts directly. <strong>Only do this if you review what your agents
        build:</strong> an agent that reads untrusted content can be tricked
        into embedding malicious code.
      </p></details>
      <form method="POST" action={`/api/sites/${siteId}/ai-scripts`} class="row" style="align-items: center; gap: 0.75rem;">
        <label style="display: inline-flex; gap: 0.5rem; align-items: center; cursor: pointer;">
          <input type="checkbox" name="ai_scripts_enabled" checked={site.ai_scripts_enabled === true} />
          <span>Allow AI to write block scripts</span>
        </label>
        <button type="submit" class="btn">Save</button>
      </form>
    </div>
  </div>

  <div data-settings-section="access" hidden={section !== 'access'} style="max-width: 720px; margin-top: 1rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">External access</h2>
      <p class="muted text-sm" style="margin: 0;">
        Generate API keys for AI agents and other external tools that need to manage this site through the public REST API.
      </p>
      <div>
        <a href={`/app/sites/${siteId}/settings/api-keys`} class="btn">Manage API keys →</a>
      </div>
    </div>
  </div>

  <div data-settings-section="integrations" hidden={section !== 'integrations'} style="max-width: 720px; margin-top: 1rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">Core modules</h2>
      <p class="muted text-sm" style="margin: 0;">
        Turn on optional features for this site — analytics and more. Everything is off by
        default; enable only what you need.
      </p>
      <div>
        <a href={`/app/sites/${siteId}/settings/apps`} class="btn">Manage modules →</a>
      </div>
    </div>
  </div>

  <div data-settings-section="integrations" hidden={section !== 'integrations'} style="max-width: 720px; margin-top: 1rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">Email &amp; notifications</h2>
      <p class="muted text-sm" style="margin: 0;">
        Connect Postmark or SMTP so forms can send submission notifications and autoresponders. Shared by the site's core modules.
      </p>
      <div>
        <a href={`/app/sites/${siteId}/settings/email`} class="btn">Manage email →</a>
        <a href={`/app/sites/${siteId}/settings/owner-review`} class="btn">Review owner changes →</a>
      </div>
    </div>
  </div>

  <div data-settings-section="access" hidden={section !== 'access'} style="max-width: 720px; margin-top: 1rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">Sharing</h2>
      <p class="muted text-sm" style="margin: 0;">
        Grant another organization read, write, or admin access to this site.
      </p>
      <div>
        <a href={`/app/sites/${siteId}/settings/sharing`} class="btn">Manage sharing →</a>
      </div>
    </div>
  </div>

  <div data-settings-section="advanced" hidden={section !== 'advanced'} style="max-width: 720px; margin-top: 1rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">{archived ? 'Archived' : 'Archive this site'}</h2>
      {archived ? (
        <>
          <p class="muted text-sm" style="margin: 0;">
            This site is archived. It is hidden from the dashboard and refuses every change and
            publication, including from API keys and agents. Nothing has been deleted, and the
            content export below still works.
          </p>
          {site.lifecycle?.reason && (
            <p class="muted text-sm" style="margin: 0; font-style: italic;">{site.lifecycle.reason}</p>
          )}
          <form method="POST" action={`/api/sites/${siteId}/lifecycle`}>
            <input type="hidden" name="action" value="restore" />
            <button type="submit" class="btn">Restore this site</button>
          </form>
        </>
      ) : (
        <>
          <p class="muted text-sm" style="margin: 0;">
            Retire a site you are finished with. It leaves the dashboard and stops accepting changes
            and publications, but nothing is deleted and you can restore it here at any time.
            Destroying a site permanently is a separate operator procedure, because it also touches
            shared media storage, your Git repository and your hosting project.
          </p>
          {domainBlocksArchiving ? (
            <p class="muted text-sm" style="margin: 0;">
              {site.domain} still points at this site. Move or remove the domain first — archiving
              stops publishing, so the live site would keep answering with no way to update it.
            </p>
          ) : (
            <form method="POST" action={`/api/sites/${siteId}/lifecycle`} class="stack">
              <input type="hidden" name="action" value="archive" />
              <label class="text-sm" for="archive-reason">Why (optional, shown here later)</label>
              <input id="archive-reason" name="reason" type="text" maxlength="500" placeholder="Superseded by the new migration" />
              <div><button type="submit" class="btn">Archive this site</button></div>
            </form>
          )}
        </>
      )}
    </div>
  </div>

  <div data-settings-section="advanced" hidden={section !== 'advanced'} style="max-width: 720px; margin-top: 1rem;">
    <div class="card stack">
      <h2 style="font-size: 1.125rem; margin: 0;">Export your content</h2>
      <p class="muted text-sm" style="margin: 0;">
        Download everything — Pages, Content types, templates, partials, forms, redirects, block types and settings — as
        JSON in the same layout the open-source site renderer builds from. Your content is yours;
        the zip includes a manifest with every media URL for mirroring the images too.
      </p>
      <div>
        <a href={`/api/sites/${siteId}/export`} class="btn" download>Download content export</a>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  [data-settings-section][hidden], [data-settings-dirty][hidden] { display: none !important; }
  .settings-navigation { max-width: 100%; margin-bottom: 1rem; }
  .settings-navigation nav { display: flex; flex-wrap: wrap; gap: .25rem; border-bottom: 1px solid var(--color-border); }
  .settings-navigation a { display: block; padding: .75rem 1rem; color: inherit; text-decoration: none; border-bottom: 3px solid transparent; }
  .settings-navigation a[aria-current="page"] { border-color: var(--color-accent); font-weight: 600; }
  .settings-navigation a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .settings-mobile-nav { display: none; }
  .settings-fields { border: 0; padding: 0; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 1rem; }
  .settings-save { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  #settings-save-status { margin: 0; }
  #settings-save-status[data-error] { color: var(--color-danger); }
  @media (max-width: 767px) {
    .settings-navigation[data-enhanced] nav { display: none; }
    .settings-navigation[data-enhanced] .settings-mobile-nav { display: grid; gap: .5rem; font-weight: 600; }
    .settings-mobile-nav select { width: 100%; min-height: 44px; }
  }
</style>
<script>
  import { initializeSiteSettings } from '../../../../lib/site-settings-navigation';
  initializeSiteSettings();
</script>
