---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { listApiKeys } from '../../../../../lib/api-keys';
import ApiKeyManager from '../../../../../components/ApiKeyManager.tsx';
import { loadSiteContext } from '../../../../../lib/access';

const ctx = await loadSiteContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { site, owner_org_id: orgId } = ctx;
const siteId = site.id;
// Key metadata names who created each key and where it was last used, so the
// page is for site admins, as the key routes are. Only the owning
// organization mints keys, so a share recipient's admin sees a note instead.
if (ctx.permission !== 'admin') return Astro.redirect(`/app/sites/${encodeURIComponent(siteId)}/settings?section=access`);
const canCreate = ctx.is_owner;

const keys = await listApiKeys(orgId, siteId);
const summaries = keys.map((k) => ({
  id: k.id,
  name: k.name,
  created_at: k.created_at,
  created_by: k.created_by,
  last_used_at: k.last_used_at,
  last_used_ip: k.last_used_ip,
  revoked_at: k.revoked_at,
}));
---
<AppLayout title={`API keys — ${site.name}`} siteId={siteId}>
  <div class="app-header">
    <h1>API keys</h1>
    <p class="muted text-sm" style="max-width: 720px;">
      Generate keys for external tools (Claude Code, custom scripts, the Typeroll MCP server) to read and update this site through the public REST API.
      Keys are scoped to <strong>{site.name}</strong> only — they cannot access other sites in your organization.
    </p>
  </div>

  <div style="max-width: 760px;">
    {canCreate
      ? <ApiKeyManager client:load siteId={siteId} initialKeys={summaries} />
      : <p class="muted">This site is shared with your organization. API keys for it are created by its owning organization; use an organization API key to reach shared sites.</p>}
  </div>

  <p class="text-sm muted" style="margin-top: 1.5rem;">
    <a href={`/app/sites/${siteId}/settings?section=access`}>← Back to site settings</a>
  </p>
</AppLayout>
