---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { loadSiteContext } from '../../../../../lib/access';
import AppsSettings from '../../../../../components/AppsSettings.tsx';

const ctx = await loadSiteContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { site, permission } = ctx;
const siteId = site.id;

// Core-module enablement can ship scripts to the live site + hold credentials — admins only.
if (permission !== 'admin') return Astro.redirect(`/app/sites/${siteId}/settings`);
---
<AppLayout title={`Core modules — ${site.name}`} siteId={siteId}>
  <div class="app-header">
    <div>
      <h1>Core modules</h1>
      <p class="muted text-sm" style="max-width: 720px;">
        Optional features you can turn on for <strong>{site.name}</strong>. Everything here is
        <strong>off by default</strong> — enable only what this site needs. Some modules add code to
        your published site and take effect on the next deploy.
      </p>
    </div>
  </div>

  <div style="max-width: 720px;">
    <AppsSettings client:load siteId={siteId} />
  </div>

  <p class="text-sm muted" style="margin-top: 1.5rem;">
    <a href={`/app/sites/${siteId}/settings`}>← Back to site settings</a>
  </p>
</AppLayout>
