---
import { vstore } from '../../../../../lib/version-store';
import AppLayout from '../../../../../layouts/AppLayout.astro';
import TemplateEditor from '../../../../../components/TemplateEditor.tsx';
import { loadSiteContext } from '../../../../../lib/access';
import { getStore } from '../../../../../lib/datastore';
import { paths, resolveRenderVersion } from '@typeroll/shared';
import type { PageTemplate, Site } from '@typeroll/shared';

const ctx = await loadSiteContext(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { session, site, versionId, owner_org_id: orgId } = ctx;
const siteId = site.id;
const { templateId } = Astro.params;
if (!templateId) return Astro.redirect('/app');

const store = getStore();
const template = await store.getDoc<PageTemplate>(
  paths.pageTemplate(orgId, siteId, templateId, versionId),
);
if (!template) return Astro.redirect(`/app/sites/${siteId}/templates`);
const templateSettings = await vstore.settings(orgId, siteId, versionId);
const globalBlockSummaries = (await vstore.partials(orgId, siteId, versionId)).filter(partial => partial.kind === 'free')
  .map(partial => ({ id: partial.id, name: partial.name, status: partial.status, content_mode: partial.content_mode }));
---
<AppLayout title={`${template.label} — Template — ${site.name}`} siteId={siteId} bare>
  <TemplateEditor globalBlocks={globalBlockSummaries} responsiveBreakpoints={templateSettings?.responsive_breakpoints} siteStyles={templateSettings?.styles ?? []} renderVersion={resolveRenderVersion(templateSettings?.render_version)} client:load siteId={siteId} template={template} />
</AppLayout>
