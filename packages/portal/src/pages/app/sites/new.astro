---
import AppLayout from '../../../layouts/AppLayout.astro';
import { importStorageStatus } from '../../../lib/media/import-policy';
import { getSession } from '../../../lib/auth';
import { readAiSettings, settingsCoverNewSites, AI_SETTINGS_PATH } from '../../../lib/ai/organization-ai';
import { organizationMembership } from '../../../lib/organization-session';
import NewSiteFromTemplate from '../../../components/NewSiteFromTemplate.tsx';
import { getStore } from '../../../lib/datastore';
import { resolveOwnerOrgAccess, siteDesignAccess } from '../../../lib/member-role';
import { listCollection } from '../../../lib/collections/collections';
import { isArchivedSite, paths, type Site } from '@typeroll/shared';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/login');
if (!session.orgId) return Astro.redirect('/onboarding');
const importStorage = await importStorageStatus(session.orgId);
// AI planning needs the organization's own key for sites created later.
const aiForNewSites = settingsCoverNewSites(await readAiSettings(session.orgId));
const membership = await organizationMembership(session.userId, session.orgId);
const canManageAi = membership?.role === 'owner' || membership?.role === 'admin';
// A new site can start as a copy of another site of this organization, or
// from a whole-site package of the collection (owners, administrators and
// builders, like the collection itself) or a .typeroll file.
const sourceSites = (await getStore().listDocs<Site>(paths.sites(session.orgId)))
  .filter(site => site.id && !isArchivedSite(site))
  .map(site => ({ id: site.id, name: site.name || site.id }))
  .sort((a, b) => a.name.localeCompare(b.name));
const access = await resolveOwnerOrgAccess(session.orgId, session.userId);
const sourcePackages = siteDesignAccess(access.permission, access.role)
  ? (await listCollection(session.orgId, { previewBase: '' })).filter(entry => entry.kind === 'package').map(entry => ({
    id: entry.id, name: entry.name,
    ...(entry.source.publisher ? { publisher: entry.source.publisher } : {}),
    ...(entry.source.verified ? { verified: true } : {}),
    ...(entry.languages?.length ? { languages: entry.languages } : {}),
    ...(typeof entry.summary.pages === 'number' ? { pages: entry.summary.pages } : {}),
  }))
  : undefined;
---
<AppLayout title="New site">
  <div class="app-header">
    <h1>Create a new site</h1>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
    <form method="POST" action="/api/sites/create" class="card stack">
      <h2 style="font-size: 1.125rem;">Start from scratch</h2>
      <p class="muted text-sm">Create a blank site you can populate yourself or with AI.</p>
      <div class="field">
        <label for="name">Site name</label>
        <input id="name" name="name" required placeholder="My new site" />
      </div>
      <div class="field">
        <label for="domain">Primary domain (optional)</label>
        <input id="domain" name="domain" placeholder="example.com" />
      </div>
      <button type="submit" class="btn">Create site</button>
    </form>

    <form method="POST" action="/api/sites/create-and-migrate" class="card stack">
      <h2 style="font-size: 1.125rem;">Migrate from WordPress</h2>
      <p class="muted text-sm">Point us at your WordPress site. We render every page as clean semantic HTML and bring over images, menus, and SEO data.</p>
      <div class="field">
        <label for="wp_name">Site name</label>
        <input id="wp_name" name="name" required placeholder="My migrated site" />
      </div>
      <div class="field">
        <label for="wp_url">WordPress URL</label>
        <input id="wp_url" name="wp_url" type="url" required placeholder="https://oldsite.com" />
      </div>
      {!importStorage.ready && <div role="status"><p>{importStorage.message}</p><a class="btn btn-secondary" href={importStorage.settings_url}>Open Publishing → Media storage</a></div>}
      <button type="submit" class="btn" disabled={!importStorage.ready}>Start migration</button>
    </form>

    <form method="POST" action="/api/sites/create-and-plan" class="card stack">
      <h2 style="font-size: 1.125rem;">Plan a new site with AI</h2>
      <p class="muted text-sm">Describe your business; AI proposes a site structure and writes every page.</p>
      <div class="field">
        <label for="plan_name">Site name</label>
        <input id="plan_name" name="name" required placeholder="My new business" />
      </div>
      <div class="field">
        <label for="plan_desc">Business description</label>
        <textarea id="plan_desc" name="business_description" required rows="3" placeholder="A small hair salon in downtown Portland…"></textarea>
      </div>
      {!aiForNewSites && <div role="status" data-ai-planning-unavailable>
        <p>Planning with AI needs your organization’s own Anthropic API key with “All sites, including sites created later” selected.</p>
        {canManageAi ? <a class="btn btn--secondary" href={AI_SETTINGS_PATH}>Open AI assistant settings</a>
          : <p class="muted text-sm">Ask an organization owner or admin to set up the AI assistant.</p>}
      </div>}
      <button type="submit" class="btn" disabled={!aiForNewSites}>Plan & generate</button>
    </form>

    <div class="ns-wide">
      <NewSiteFromTemplate client:load sites={sourceSites} packages={sourcePackages} />
    </div>
  </div>

  <style is:global>
    .ns-wide { grid-column: 1 / -1; min-width: 0; }
    .ns-wide .ns-card { max-width: 760px; }
    .ns-card h2 { font-size: 1.125rem; margin: 0; }
    .ns-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .ns-fieldset { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: .65rem .85rem; display: grid; gap: .45rem; min-width: 0; margin: 0; }
    .ns-fieldset legend { font-weight: 600; padding: 0 .35rem; font-size: .9rem; }
    .ns-radio, .ns-check { display: flex !important; align-items: flex-start; gap: .5rem; cursor: pointer; font-weight: 400; font-size: .9rem; }
    .ns-radio input, .ns-check input { width: auto; margin-top: 4px; flex-shrink: 0; }
    .ns-drop { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; padding: .85rem; border: 2px dashed var(--color-border); border-radius: var(--radius-md); }
    .ns-drop:focus-within { border-color: var(--color-primary); }
    .ns-progress { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
    .ns-progress progress { width: min(12rem, 100%); }
    .ns-stale { opacity: .6; }
    .ns-signature { padding: .5rem .75rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); font-size: .875rem; overflow-wrap: anywhere; }
    .ns-signature--ok { border-color: var(--color-success); background: color-mix(in srgb, var(--color-success) 8%, var(--color-surface)); }
    .ns-signature--warn { border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-border)); background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface)); }
    .ns-signature--danger { border-color: var(--color-danger); background: color-mix(in srgb, var(--color-danger) 7%, var(--color-surface)); color: var(--color-danger); }
    .ns-facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .2rem .85rem; margin: 0; font-size: .875rem; }
    .ns-facts dt { color: var(--color-text-muted); }
    .ns-facts dd { margin: 0; overflow-wrap: anywhere; }
    .ns-warnings { padding: .5rem .75rem; border-radius: var(--radius-md); border: 1px solid color-mix(in srgb, var(--color-accent) 50%, var(--color-border)); background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface)); font-size: .875rem; }
    .ns-warnings ul, .ns-error ul, .ns-blockers { margin: .25rem 0 0; padding-left: 1.2rem; }
    .ns-error { color: var(--color-danger); font-size: .875rem; padding: .5rem .75rem; border: 1px solid color-mix(in srgb, var(--color-danger) 45%, var(--color-border)); border-radius: var(--radius-md); }
    @media (max-width: 480px) { .ns-facts { grid-template-columns: minmax(0, 1fr); } .ns-facts dd { margin-bottom: .3rem; } }
  </style>
</AppLayout>
