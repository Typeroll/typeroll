---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LoginForm from '../components/LoginForm.tsx';
import { isDevAuthEnabled, isAccountSignInConfigured, getSessionIdentity } from '../lib/auth';
import { githubSignInConfigured } from '../lib/identity/portal-auth';
import { oauthErrorMessage } from '../lib/auth-errors';
import { safeReturnPath } from '../lib/return-path';

// If already signed in, send where they need to go.
// Accounts without a confirmed email go to "Check your email". Pending
// sessions (no org yet) go to onboarding; full sessions go to the app,
// or back to the application page that asked them to sign in again.
const next = safeReturnPath(Astro.url.searchParams.get('next'));
const session = await getSessionIdentity(Astro.cookies);
if (session && !session.emailVerified) return Astro.redirect(`/verify-email${next ? `?next=${encodeURIComponent(next)}` : ''}`);
if (session) return Astro.redirect(session.orgId ? next ?? '/app' : next?.startsWith('/onboarding') ? next : `/onboarding${next ? `?next=${encodeURIComponent(next)}` : ''}`);

// `?mode=signup` opens account creation directly, e.g. from a "Create an account" link.
const initialMode = Astro.url.searchParams.get('mode') === 'signup' ? 'signup' : 'signin';
const accountsReady = isAccountSignInConfigured();
const devAuthEnabled = isDevAuthEnabled();
const githubSignIn = accountsReady && githubSignInConfigured();
const initialError = oauthErrorMessage(Astro.url.searchParams.get('error'));
---
<MarketingLayout title="Sign in — Typeroll">
  <section class="container--narrow" style="padding: 4rem 1.5rem;">
    <div class="card stack">
      <h1 style="font-size: 1.5rem;">Welcome to Typeroll</h1>
      {accountsReady ? (
        <LoginForm client:load next={next} initialMode={initialMode} githubSignIn={githubSignIn} initialError={initialError} />
      ) : devAuthEnabled ? (
        <>
          <p class="muted text-sm">
            Sign-in is not configured on this server. Dev mode is enabled — click below to continue with a local dev session.
          </p>
          <form method="POST" action="/api/auth/dev-session">
            {next && <input type="hidden" name="next" value={next} />}
            <button type="submit" class="btn" style="width: 100%; justify-content: center;">
              Continue as Dev User
            </button>
          </form>
          <p class="muted text-sm">
            To enable accounts, set <code>AUTH_SECRET</code> (at least 32 characters) and <code>PORTAL_PUBLIC_URL</code>.
          </p>
        </>
      ) : (
        <p class="muted text-sm">
          Sign-in is unavailable because <code>AUTH_SECRET</code> is not configured on this production server.
        </p>
      )}
    </div>
  </section>
</MarketingLayout>
