---
// /reset-password — reached from the password reset email through
// /api/auth/reset-password/:token, which checks the token and adds it here.
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ResetPasswordForm from '../components/ResetPasswordForm.tsx';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const raw = Astro.url.searchParams.get('error') ? null : Astro.url.searchParams.get('token');
const token = raw && /^[A-Za-z0-9_-]{8,200}$/.test(raw) ? raw : null;
---
<MarketingLayout title="Choose a new password — Typeroll">
  <section class="container--narrow" style="padding: 4rem 1.5rem;">
    <div class="card stack">
      <h1 style="font-size: 1.5rem;">Choose a new password</h1>
      <ResetPasswordForm client:load token={token} />
    </div>
  </section>
</MarketingLayout>
