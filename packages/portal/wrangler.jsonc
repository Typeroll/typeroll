// Base Worker configuration for the portal. Local development (`astro dev`,
// `astro build`) uses it as is; Cloud releases derive the staging and
// production configurations from it (names, routes, secrets) without changing
// bindings or migrations.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "typeroll-portal",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // EU isolation: no Workers Logs or traces (Logpush to EU R2 instead), no
  // Smart Placement.
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "durable_objects": {
    "bindings": [
      // One object per site, per organization and one global object. Stubs are
      // always created through `jurisdiction("eu")`.
      { "name": "STORE", "class_name": "DocumentStore" }
    ]
  },
  // Cutover exports and checkpoints (runbook). Steps run only with
  // TYPEROLL_MIGRATION=allow.
  "r2_buckets": [
    { "binding": "MIGRATION", "bucket_name": "typeroll-migration", "jurisdiction": "eu" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DocumentStore"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  // Store alarms deliver due work through this Worker's own entrypoint.
  "services": [{ "binding": "SCHEDULER", "service": "typeroll-portal", "entrypoint": "Scheduler" }],
  "vars": {
    "TYPEROLL_RUNTIME": "workers",
    // Durable Object jurisdiction; `.dev.vars` may set "none" for local workerd.
    "STORE_JURISDICTION": "eu",
    "TYPEROLL_SCHEDULER": "durable_object"
  }
}
