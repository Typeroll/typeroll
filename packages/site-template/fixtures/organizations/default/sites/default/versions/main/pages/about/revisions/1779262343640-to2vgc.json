        }
      },
      {
        "id": "m-718e83f21d6b3ff70e6f",
        "type": "core/prose",
        "data": {
          "html": "<p>We migrate WordPress sites onto a static, CDN-hosted stack. The result is faster, more secure, and never needs maintenance again.</p>",
