---
import type { ExtensionIncludeDescriptor, Partial as PartialDoc, RenderContext, SiteSettings } from '@typeroll/shared';
import { cookieFooterLinkHtml, platformLayer, resolveRenderVersion, withCookieFooterLink } from '@typeroll/shared';
import { getBuildYear, renderPartialHtml } from '../lib/content';

interface Props {
  partial: PartialDoc | null;
  settings: SiteSettings;
  /** The page's render context, so {{site.*}} and context-bound blocks in the
   *  footer resolve the same way they do in the portal's preview. */
  context?: RenderContext;
  freeBlocks?: PartialDoc[];
  extensionSource?: (blockTypeId: string) => ExtensionIncludeDescriptor | undefined;
}

const { partial, settings, context, freeBlocks, extensionSource } = Astro.props;

// Rendered + sanitized once per distinct partial content, unless the partial
// can vary by route — see renderPartialHtml.
const rendered: string | null = partial
  ? await renderPartialHtml(partial, context, { freeBlocks, extensionSource, iframeAllowedHosts: settings.iframe_allowed_hosts })
  : null;

const startsWithFooter = !!rendered && /^\s*(?:<!--[\s\S]*?-->\s*)*<footer(?:\s|>)/i.test(rendered);
const year = getBuildYear();
// From render version 16 the default footer's styles sit in the base layer,
// so site CSS restyles it without !important. Older versions keep the scoped styles.
const renderVersion = resolveRenderVersion(settings.render_version);
// The cookie banner's "Cookie settings" link (manage_button "footer", the default
// from render version 19) ends the footer unless the footer already has one.
const language = (context?.page as { language?: string } | undefined)?.language || settings.language;
const html = rendered ? withCookieFooterLink(rendered, settings.cookie_consent, { language, renderVersion }) : null;
const defaultFooterLink = rendered ? '' : cookieFooterLinkHtml(settings.cookie_consent, { language, renderVersion });
const layered = renderVersion >= 16;
const defaultFooterCss = `.site-footer--layered { border-top:1px solid var(--color-surface); background:var(--color-background); color:var(--color-text-light); margin-top:var(--spacing-xl); }
.site-footer--layered .site-footer__inner { max-width:var(--container-wide); margin:0 auto; padding:var(--spacing-lg) var(--spacing-md); text-align:center; font-size:0.875rem; }`;
---
{html && startsWithFooter ? (
  <Fragment set:html={html} />
) : html ? (
  <footer class="site-footer" set:html={html} />
) : (
  <footer class:list={['site-footer', 'site-footer--default', layered && 'site-footer--layered']}>
    {layered && <style set:html={platformLayer('base', defaultFooterCss, renderVersion)} />}
    <div class="site-footer__inner">
      <p>&copy; {year} {settings.site_name}</p>
    </div>
    {defaultFooterLink && <Fragment set:html={defaultFooterLink} />}
  </footer>
)}

<style>
  .site-footer--default:where(:not(.site-footer--layered)) {
    border-top: 1px solid var(--color-surface);
    background: var(--color-background);
    color: var(--color-text-light);
    margin-top: var(--spacing-xl);
  }
  :where(.site-footer--default:not(.site-footer--layered)) .site-footer__inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
    font-size: 0.875rem;
  }
</style>
