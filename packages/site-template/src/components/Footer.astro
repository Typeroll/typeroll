---
import type { Partial as PartialDoc, RenderContext, SiteSettings } from '@typeroll/shared';
import { renderPartialHtml } from '../lib/content';

interface Props {
  partial: PartialDoc | null;
  settings: SiteSettings;
  /** The page's render context, so {{site.*}} and context-bound blocks in the
   *  footer resolve the same way they do in the portal's preview. */
  context?: RenderContext;
}

const { partial, settings, context } = Astro.props;

// Rendered + sanitized once per distinct partial content, unless the partial
// can vary by route — see renderPartialHtml.
const html: string | null = partial ? await renderPartialHtml(partial, context) : null;

const startsWithFooter = !!html && /^\s*(?:<!--[\s\S]*?-->\s*)*<footer(?:\s|>)/i.test(html);
const year = new Date().getFullYear();
---
{html && startsWithFooter ? (
  <Fragment set:html={html} />
) : html ? (
  <footer class="site-footer" set:html={html} />
) : (
  <footer class="site-footer site-footer--default">
    <div class="site-footer__inner">
      <p>&copy; {year} {settings.site_name}</p>
    </div>
  </footer>
)}

<style>
  .site-footer--default {
    border-top: 1px solid var(--color-surface);
    background: var(--color-background);
    color: var(--color-text-light);
    margin-top: var(--spacing-xl);
  }
  .site-footer__inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
    font-size: 0.875rem;
  }
</style>
