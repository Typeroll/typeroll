---
import type { BreadcrumbItem, ContentType, Page, PostalAddress, SiteSettings } from '@typeroll/shared';
import { socialMetadata, resolveAlternates, pageRobots, schemaDate, breadcrumbJsonLd as buildBreadcrumbJsonLd } from '@typeroll/shared';
import { isVersionRobotsBlocked } from '../lib/content';

interface Props {
  page: Page;
  contentType?: ContentType;
  settings: SiteSettings;
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Additional JSON-LD objects to emit alongside the auto-generated ones.
   * Each entry is a *pre-serialised* JSON string (the caller has already
   * called JSON.stringify). Used for context-specific schemas the static
   * page itself doesn't know how to build — content-type Schema.org
   * objects (PodcastEpisode, BlogPosting, …), page-specific schemas
   * (Service, Course, …). Pass strings, not objects, so the caller is
   * the single place that has to know about </script> escaping.
   */
  extraJsonLd?: string[];
}

const { page, contentType, settings, extraJsonLd, breadcrumbs = [] } = Astro.props;
const publishedDate = schemaDate(page.date_published);
const modifiedDate = schemaDate(page.date_updated);

const isHome = Astro.url.pathname === '/';
const isArticle = page.kind === 'article';

const title = (() => {
  const base = page.seo_title || page.title;
  if (!settings.default_seo_suffix || page.append_seo_suffix === false) return base;
  return base.endsWith(settings.default_seo_suffix) ? base : `${base}${settings.default_seo_suffix}`;
})();

// Description fallback chain: page-specific → site default → tagline.
const description =
  page.seo_description || settings.default_meta_description || settings.tagline || '';

const canonical = page.canonical_url || new URL(Astro.url.pathname, Astro.site).toString();

const social = socialMetadata(page, settings, contentType, new URL(Astro.url.pathname, Astro.site).href);
const ogImage = social.image;
const ogImageAlt = social.imageAlt;
const language = page.language || settings.language || 'en';
const locale = social.locale;

// hreflang cluster. Only the OTHER language variants are declared on the
// page; the self-reference is injected here because Google drops a cluster
// whose members don't all list themselves. Invalid entries are dropped by
// the shared validator rather than escaped into the attribute.
const alternates = resolveAlternates(page.alternates, canonical, language);

// Page-level and explicit site-wide noindex win; otherwise the version
// (branches default to blocked).
const versionBlocked = await isVersionRobotsBlocked();
const robots = pageRobots(page, settings, versionBlocked);

// Twitter site handle — used for both site and (in absence of an author
// override) creator. Stored without the leading @.
const twHandle = settings.twitter_handle?.replace(/^@/, '');

function safeJsonLd(str: string | null | undefined): string | null {
  if (!str) return null;
  // The script tag is emitted via set:html, so an attacker-controlled JSON
  // string could close the tag and inject markup. The Unicode escapes the
  // JSON parser still accepts.
  return str.replace(/<\/script/gi, '<\\/script').replace(/<!--/g, '\\u003C!--');
}

// Per-page JSON-LD set by the editor / AI (e.g. FAQPage, Recipe).
const pageJsonLd = safeJsonLd(page.json_ld);

// Auto Organization schema. Site-level — Typeroll orgs can host many
// brands (an agency with 100 customer sites), so the Organization
// represented in JSON-LD is the *site's* brand, not the platform org.
// Data is pulled from existing SiteSettings fields:
//   - name:      organization.name || site_name
//   - logo:      organization.logo || logo
//   - email:     contact.email
//   - telephone: contact.phone
//   - address:   contact.address (string → no structured emit; object →
//                PostalAddress with camelCase Schema.org property names)
//   - sameAs:    organization.same_as ∪ social.* URLs
// Emits on home only — repeating Organization on every page is noisy
// and Google explicitly recommends a single canonical declaration.
function postalAddressJsonLd(addr: PostalAddress): Record<string, unknown> {
  const out: Record<string, unknown> = { '@type': 'PostalAddress' };
  if (addr.street_address) out.streetAddress = addr.street_address;
  if (addr.postal_code) out.postalCode = addr.postal_code;
  if (addr.address_locality) out.addressLocality = addr.address_locality;
  if (addr.address_region) out.addressRegion = addr.address_region;
  if (addr.address_country) out.addressCountry = addr.address_country;
  return out;
}

function collectSameAs(): string[] {
  const out: string[] = [];
  const social = settings.social ?? {};
  for (const key of ['facebook', 'instagram', 'linkedin', 'x', 'youtube'] as const) {
    const v = social[key];
    if (typeof v === 'string' && v.startsWith('http')) out.push(v);
  }
  const override = settings.organization?.same_as ?? [];
  for (const url of override) {
    if (typeof url === 'string' && url && !out.includes(url)) out.push(url);
  }
  return out;
}

function orgSchema(): string | null {
  if (!isHome) return null;
  const org = settings.organization ?? {};
  const contact = settings.contact ?? {};
  const name = org.name || settings.site_name;
  if (!name) return null;
  const obj: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name,
  };
  if (Astro.site) obj.url = Astro.site.toString();
  const logo = org.logo || settings.logo;
  if (logo) obj.logo = logo;
  if (contact.email) obj.email = contact.email;
  if (contact.phone) obj.telephone = contact.phone;
  if (contact.address && typeof contact.address === 'object') {
    obj.address = postalAddressJsonLd(contact.address);
  }
  const sameAs = collectSameAs();
  if (sameAs.length) obj.sameAs = sameAs;
  return safeJsonLd(JSON.stringify(obj));
}

// Auto WebSite schema on home only. Drives sitelinks search box if a real
// search endpoint is wired up later — for now we just declare the site
// itself, which Google still uses for entity disambiguation.
function websiteSchema(): string | null {
  if (!isHome || !Astro.site) return null;
  const obj: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: Astro.site.toString(),
    name: settings.site_name,
  };
  if (settings.tagline) obj.description = settings.tagline;
  return safeJsonLd(JSON.stringify(obj));
}

// Auto Article schema for kind=article pages.
function articleSchema(): string | null {
  if (!isArticle) return null;
  const obj: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: page.title,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  };
  if (description) obj.description = description;
  if (ogImage) obj.image = ogImage;
  if (publishedDate) obj.datePublished = publishedDate;
  if (modifiedDate) obj.dateModified = modifiedDate;
  if (page.author) obj.author = { '@type': 'Person', name: page.author };
  if (settings.organization?.name) {
    obj.publisher = {
      '@type': 'Organization',
      name: settings.organization.name,
      ...(settings.organization.logo
        ? { logo: { '@type': 'ImageObject', url: settings.organization.logo } }
        : {}),
    };
  }
  return safeJsonLd(JSON.stringify(obj));
}

// Use the resolved navigation trail, including content-type route prefixes.
// Do not infer intermediate routes from a slug: they may not be real pages.
function breadcrumbSchema(): string | null {
  if (!Astro.site || page.id === '404') return null;
  return safeJsonLd(buildBreadcrumbJsonLd({ pathname: Astro.url.pathname, canonical, baseUrl: Astro.site.href,
    title: page.title, siteName: settings.site_name, breadcrumbs }));
}

const orgJsonLd = orgSchema();
const websiteJsonLd = websiteSchema();
const articleJsonLd = articleSchema();
const breadcrumbJsonLd = breadcrumbSchema();
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}

<meta property="og:title" content={social.title} />
<meta property="og:description" content={social.description} />
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={settings.site_name} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

{isArticle && publishedDate && (
  <meta property="article:published_time" content={publishedDate} />
)}
{isArticle && modifiedDate && (
  <meta property="article:modified_time" content={modifiedDate} />
)}
{isArticle && page.author && (
  <meta property="article:author" content={page.author} />
)}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={social.title} />
<meta name="twitter:description" content={social.description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
{twHandle && <meta name="twitter:site" content={`@${twHandle}`} />}
{twHandle && <meta name="twitter:creator" content={`@${twHandle}`} />}

{settings.favicon && <link rel="icon" href={settings.favicon} />}
{settings.apple_touch_icon && <link rel="apple-touch-icon" sizes="180x180" href={settings.apple_touch_icon} />}
{settings.icon_192 && <link rel="icon" type="image/png" sizes="192x192" href={settings.icon_192} />}

{pageJsonLd && (
  <script type="application/ld+json" set:html={pageJsonLd} />
)}
{orgJsonLd && (
  <script type="application/ld+json" set:html={orgJsonLd} />
)}
{websiteJsonLd && (
  <script type="application/ld+json" set:html={websiteJsonLd} />
)}
{articleJsonLd && (
  <script type="application/ld+json" set:html={articleJsonLd} />
)}
{breadcrumbJsonLd && (
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
)}
{extraJsonLd?.map((raw) => {
  const safe = safeJsonLd(raw);
  return safe ? <script type="application/ld+json" set:html={safe} /> : null;
})}
