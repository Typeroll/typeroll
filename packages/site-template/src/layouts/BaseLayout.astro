---
import type { BreadcrumbItem, ContentType, ExtensionRuntimeSnapshot, Page, SiteApps, SiteSettings } from '@typeroll/shared';
import { directionCss, languageDirection, resolveBreakpointWidths, resolveRenderVersion, siteStylesCss, styleElementText, siteThemeCss, webFontFamilies, googleFontsCssUrl, fontDelivery, SELF_HOSTED_FONTS_CSS_PATH, WEBFONT_FALLBACK_CSS, contentWellCss, buildConsentEarlyPaintRuntime, buildExtensionRuntimeScript, renderClientCapabilityScripts, renderIntegrationTags, wrapConsentScripts, STICKY_HEADER_RUNTIME_JS } from '@typeroll/shared';
import SEOHead from '../components/SEOHead.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/reset.css';
import '../styles/global.css';

interface Props {
  page: Page;
  contentType?: ContentType;
  /**
   * `data-*` attributes describing which route this is, spread onto <body>.
   * Built by `pageIdentityAttributes`; absent keys are absent attributes, so
   * a selector never matches a page that lacks the thing it names.
   */
  identity?: Record<string, string>;
  settings: SiteSettings;
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Public apps snapshot (enabled Typeroll apps + their public config).
   * Drives opt-in injections like the analytics beacon. Absent → no apps.
   */
  apps?: SiteApps;
  /** Public, secret-free metadata for enabled external Extensions. */
  extensions?: ExtensionRuntimeSnapshot;
  /**
   * Concatenated CSS for every block type used by this page. Inlined in
   * <head> so blocks render unstyled-free on first paint. Tree-shaken
   * per-page by the renderer — pages that don't use a block don't pay
   * for its CSS.
   */
  blockCss?: string;
  /**
   * Concatenated JS for every block type with a `script` field that's
   * used on this page. Loaded at end-of-body — non-blocking. Wrapped in
   * an IIFE that exposes window.TyperollBlocks.register/init so
   * blocks coordinate without polluting global scope.
   */
  blockJs?: string;
  /**
   * Client capabilities the blocks on this page asked for — see
   * collectClientCapabilities. Drives which provider loaders ship, so a key
   * configured once does not put a third-party script on every page.
   */
  clientCapabilities?: string[];
  /**
   * Pre-serialised JSON-LD objects emitted into <head> alongside the
   * auto-generated ones in SEOHead. Used for context-specific schemas the
   * static page itself doesn't know how to build — collection-item shapes
   * (PodcastEpisode, BlogPosting, …), page-specific shapes (Service,
   * Course, …). See SEOHead for the contract.
   */
  extraJsonLd?: string[];
  /** Media records by URL, for the share image's size and type (see SEOHead). */
  mediaByUrl?: { get(url: string): { width?: number; height?: number; mime_type?: string } | undefined };
  /** The first section's background image, preloaded because CSS reveals it late. */
  preloadImage?: string | null;
}

const { page, contentType, settings, blockCss, blockJs, clientCapabilities, extraJsonLd, apps, extensions, breadcrumbs, mediaByUrl, preloadImage } = Astro.props;
const extensionRuntime = extensions?.installations?.length
  ? buildExtensionRuntimeScript(extensions, { analytics: apps?.apps?.analytics?.enabled && typeof apps.apps.analytics.config.event_token === 'string' && typeof apps.apps.analytics.config.event_endpoint === 'string'
      ? { endpoint: apps.apps.analytics.config.event_endpoint, token: apps.apps.analytics.config.event_token, requires_consent: settings.cookie_consent?.enabled === true } : undefined })
  : '';
const extensionUsesSensitiveUrlContext = Boolean(extensions?.installations.some((installation) =>
  installation.components.some((component) => {
    const declaration = component.url_context;
    return [
      ...(declaration?.query ?? []),
      ...(declaration?.fragment ?? []),
      ...(declaration?.path ?? []),
      ...(declaration?.raw_query ? [declaration.raw_query] : []),
    ].some((input) => input.sensitive === true);
  }),
));

// Analytics app (opt-in): inject the Cloudflare Web Analytics beacon when the
// app is enabled AND a beacon token is present. Cookieless; deferred. Only
// the public token reaches here (materialize filters), so it's safe to embed.
// Integrations app (opt-in): ~20 third-party tags built from validated IDs
// in the app config. Tags outside the `necessary` consent category go
// through the SAME gate as cookie_consent.scripts_optional — held inert
// until the visitor accepts — so the site has one consent mechanism, not
// two. With no banner enabled the owner declared no consent requirement and
// they fire directly.
const integrations = apps?.apps?.integrations?.enabled
  ? renderIntegrationTags(apps.apps.integrations.config)
  : null;
const consentGated = settings.cookie_consent?.enabled === true;
const integrationsHead = integrations
  ? integrations.head + (consentGated ? wrapConsentScripts(integrations.headConsent) : integrations.headConsent)
  : '';
// Block capabilities: an owner-supplied public client key reaching a native
// block. Emitted only for capabilities the page's blocks actually declared,
// and only once each however many blocks want it. Routed through the same
// consent gate as every other non-necessary integration tag.
const capabilities = apps?.apps?.integrations?.enabled && clientCapabilities?.length
  ? renderClientCapabilityScripts(apps.apps.integrations.config, clientCapabilities)
  : null;
const capabilityHead = capabilities
  ? capabilities.tags + (consentGated ? wrapConsentScripts(capabilities.consentTags) : capabilities.consentTags)
  : '';
const integrationsBodyEnd = integrations
  ? integrations.bodyEnd + (consentGated ? wrapConsentScripts(integrations.bodyEndConsent) : integrations.bodyEndConsent)
  : '';

const analyticsBeacon = (apps?.apps?.analytics?.enabled
  && typeof apps.apps.analytics.config?.beacon_token === 'string'
  && apps.apps.analytics.config.beacon_token)
  ? String(apps.apps.analytics.config.beacon_token)
  : null;

// Theme tokens and webfont handling are shared with the portal preview so an
// editor or agent preview renders the same head CSS as the published page.
const f = {
  heading: settings.fonts?.heading ?? 'Inter',
  body: settings.fonts?.body ?? 'Inter',
  mono: settings.fonts?.mono,
};
const themeStyle = siteThemeCss(settings);

const googleFontFamilies = webFontFamilies(f.heading, f.body, f.mono);
// Self-hosted by default: the build copies the files to this origin, so no
// visitor request reaches Google before consent (fontDelivery).
const selfHostedFonts = googleFontFamilies.length > 0 && fontDelivery(settings.fonts) === 'self_hosted';
const googleFontUrl = selfHostedFonts ? null : googleFontsCssUrl(googleFontFamilies);
const fontStylesheetUrl = selfHostedFonts ? SELF_HOSTED_FONTS_CSS_PATH : googleFontUrl;

// CLS guard: while the Google webfont is loading, the browser uses the
// generic fallback (Arial / sans-serif). When the webfont arrives and
// swaps in, layout shifts unless the fallback metrics are close enough.
// `size-adjust` + override descriptors fake-match Arial's metrics to
// Inter's (the platform default). Sites that use a wildly different
// font still get *some* shift, but the average case drops from CLS
// ~0.2 (autopilot.se field report) to <0.05.
const fontFallbackStyle = googleFontFamilies.length ? WEBFONT_FALLBACK_CSS : null;
// The site's style library; empty for a site without styles.
// Right-to-left pages get dir and the mirror stylesheet; left-to-right output is unchanged.
const direction = languageDirection(page.language || settings.language || 'en');
const siteStyles = siteStylesCss(settings.styles, { breakpoints: resolveBreakpointWidths(settings.responsive_breakpoints), colors: settings.colors ?? {}, renderVersion: resolveRenderVersion(settings.render_version) });
---
<!doctype html>
<html lang={page.language || settings.language || 'en'} dir={direction === 'rtl' ? 'rtl' : undefined} data-tr-render={resolveRenderVersion(settings.render_version)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {extensionUsesSensitiveUrlContext && <meta name="referrer" content="no-referrer" />}

    <SEOHead contentType={contentType} page={page} settings={settings} extraJsonLd={extraJsonLd} breadcrumbs={breadcrumbs} mediaByUrl={mediaByUrl} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <style set:html={themeStyle} />
    <style set:html={contentWellCss(resolveRenderVersion(settings.render_version))} />

    {googleFontUrl && (
      <>
        {/* Only when the site opts into the Google Fonts CDN: warm its TLS handshakes. */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      </>
    )}
    {fontStylesheetUrl && (
      <>
        {/* The preload/onload swap keeps the font stylesheet off the render
           path; <noscript> covers crawlers. The size-adjusted 'tr-fallback'
           face below keeps layout stable while the webfont swaps in. */}
        <link
          rel="preload"
          as="style"
          href={fontStylesheetUrl}
          onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript><link rel="stylesheet" href={fontStylesheetUrl} /></noscript>
      </>
    )}
    {fontFallbackStyle && <style set:html={fontFallbackStyle} />}

    {blockCss && <style set:html={blockCss} />}
    {direction === 'rtl' && <style data-direction set:html={directionCss(direction)} />}
    {siteStyles && <style data-site-styles set:html={siteStyles} />}
    {settings.custom_css && <style set:html={styleElementText(settings.custom_css)} />}
    {/* Page-level CSS after site CSS so a page can override the site theme. */}
    {page.custom_css && <style set:html={styleElementText(page.custom_css)} />}
    {settings.scripts_head && <Fragment set:html={settings.scripts_head} />}
    {integrationsHead && <Fragment set:html={integrationsHead} />}
    {capabilityHead && <Fragment set:html={capabilityHead} />}

    {/* Analytics app (opt-in): Cloudflare Web Analytics beacon. Cookieless,
       deferred; the token is the public client beacon token. */}
    {analyticsBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsBeacon })}
      />
    )}

    {/* Early-paint flag for cookie consent: if no choice cookie is set, add
       a class to <html> BEFORE the body renders so the modal isn't a visible
       afterthought. Tiny inline script — no measurable perf cost; runs
       synchronously during HTML parse. */}
    {settings.cookie_consent?.enabled && (
      <script is:inline set:html={buildConsentEarlyPaintRuntime()} />
    )}
  </head>
  <body {...(Astro.props.identity ?? {})}>
    <slot />
    {/* Before the block scripts: reserves the sticky header's height for every scroll-into-view. */}
    <script is:inline set:html={STICKY_HEADER_RUNTIME_JS} />
    {blockJs && (
      <script set:html={`(function(){var registry={};window.TyperollBlocks={register:function(id,init){registry[id]=init;},init:function(){Object.keys(registry).forEach(function(id){document.querySelectorAll('[data-block-type="'+id+'"]').forEach(function(el){try{registry[id](el,JSON.parse(el.getAttribute('data-block-data')||'{}'));}catch(e){console.error('[block init]',id,e);}});});}};${blockJs};window.TyperollBlocks.init();})();`} />
    )}
    {extensionRuntime && <script is:inline set:html={extensionRuntime} />}
    {integrationsBodyEnd && <Fragment set:html={integrationsBodyEnd} />}
    {settings.scripts_body_end && <Fragment set:html={settings.scripts_body_end} />}

    <CookieConsent settings={settings} language={page.language || settings.language} />
  </body>
</html>
